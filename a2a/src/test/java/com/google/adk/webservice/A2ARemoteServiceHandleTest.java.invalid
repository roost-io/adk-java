        MessageSendParams params = new MessageSendParams();
        // message is null
        SendMessageRequest request = new SendMessageRequest();
        request.setId("testId");
        request.setParams(params);
        SendMessageResponse response = service.handle(request);
        assertNotNull(response);
        assertEquals("testId", response.getId());
        assertNotNull(response.getError());
        assertEquals(-32602, response.getError().getCode());
        assertEquals("Request message payload is missing", response.getError().getMessage());
    }
    @Test
    @Tag("valid")
    public void handleExistingContextId() {
        String existingContextId = "existing-context-id";
        Message message = new Message.Builder()
                .contextId(existingContextId)
                .taskId("task123")
                .build();
        MessageSendParams params = new MessageSendParams() {
            @Override
            public Message message() {
                return message;
            }
        };
        SendMessageRequest request = new SendMessageRequest();
        request.setId("reqId");
        request.setParams(params);
        Message resultMessage = new Message.Builder()
                .contextId(existingContextId)
                .taskId("task123")
                .build();
        when(executor.execute(any(Message.class))).thenReturn(resultMessage);
        SendMessageResponse response = service.handle(request);
        assertNotNull(response);
        assertEquals("reqId", response.getId());
        assertEquals(existingContextId, response.getMessage().getContextId());
    }
