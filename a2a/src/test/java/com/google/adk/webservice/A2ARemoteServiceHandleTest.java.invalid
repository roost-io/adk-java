    @BeforeEach
    public void setUp() {
        executor = Mockito.mock(A2ASendMessageExecutor.class);
        // Instantiate A2ARemoteService with the mocked executor
        service = new A2ARemoteService(executor);
    }
    @Test
    @Tag("invalid")
    public void handleNullRequest() {
        SendMessageResponse response = service.handle(null);
        assertNotNull(response);
        assertNull(response.getId()); // request is null, so response id should be null
        assertNotNull(response.getError());
        assertEquals(-32602, response.getError().getCode());
        assertEquals("Request body is missing", response.getError().getMessage());
    }
    @Test
    @Tag("invalid")
    public void handleNullParams() {
        SendMessageRequest request = new SendMessageRequest();
        request.setId("testId");
        // params is null
        SendMessageResponse response = service.handle(request);
        assertNotNull(response);
        assertEquals("testId", response.getId());
        assertNotNull(response.getError());
        assertEquals(-32602, response.getError().getCode());
        assertEquals("Request params are missing", response.getError().getMessage());
    }
