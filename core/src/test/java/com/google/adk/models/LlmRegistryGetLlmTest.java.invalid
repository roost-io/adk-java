package com.google.adk.models;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.TimeUnit;
import java.util.function.Function;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Assertions;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;

@ExtendWith(MockitoExtension.class)
public class LlmRegistryGetLlmTest {
    @Mock
    private Function<String, BaseLlm> factory;
    @Mock
    private Function<String, BaseLlm> alphaFactory;
    @Mock
    private Function<String, BaseLlm> betaFactory;
    @Mock
    private BaseLlm baseLlm1;
    @Mock
    private BaseLlm baseLlm2;
    @Test
    @Tag("integration")
    public void returnsInstanceForDefaultGeminiPattern() {
        // TODO: Update the model name if the default Gemini pattern changes in the registry
        final String modelName = "gemini-1.5-pro";
        BaseLlm actual = LlmRegistry.getLlm(modelName);
        Assertions.assertNotNull((BaseLlm) actual);
    }
    @Test
    @Tag("valid")
    public void returnsSameInstanceForSameModelNameBecauseOfCaching() {
        final String pattern = "^test-model-\\d+$";
        final String model = "test-model-100";
        BaseLlm expected = mock(BaseLlm.class);
        when(factory.apply(model)).thenReturn(expected);
        LlmRegistry.registerTestLlm(pattern, factory);
        BaseLlm first = LlmRegistry.getLlm(model);
        BaseLlm second = LlmRegistry.getLlm(model);
        Assertions.assertSame((BaseLlm) expected, (BaseLlm) first);
        Assertions.assertSame((BaseLlm) first, (BaseLlm) second);
        verify(factory, times(1)).apply(model);
    }
    @Test
    @Tag("boundary")
    public void returnsDifferentInstancesForDifferentModelNamesUnderSamePattern() {
        final String pattern = "^test-model-\\d+$";
        final String model1 = "test-model-100";
        final String model2 = "test-model-200";
        BaseLlm llmForModel1 = mock(BaseLlm.class);
        BaseLlm llmForModel2 = mock(BaseLlm.class);
        when(factory.apply(model1)).thenReturn(llmForModel1);
        when(factory.apply(model2)).thenReturn(llmForModel2);
        LlmRegistry.registerTestLlm(pattern, factory);
        BaseLlm actual1 = LlmRegistry.getLlm(model1);
        BaseLlm actual2 = LlmRegistry.getLlm(model2);
        Assertions.assertSame((BaseLlm) llmForModel1, (BaseLlm) actual1);
        Assertions.assertSame((BaseLlm) llmForModel2, (BaseLlm) actual2);
        Assertions.assertNotSame((BaseLlm) actual1, (BaseLlm) actual2);
        verify(factory, times(1)).apply(model1);
        verify(factory, times(1)).apply(model2);
    }
    @Test
    @Tag("invalid")
    public void throwsIllegalArgumentExceptionForUnsupportedModel() {
        final String unsupportedModel = "unknown-model-name";
        IllegalArgumentException ex = Assertions.assertThrows(IllegalArgumentException.class, () -> {
            LlmRegistry.getLlm(unsupportedModel);
        });
        Assertions.assertNotNull((IllegalArgumentException) ex);
    }
    @Test
    @Tag("valid")
    public void factorySelectionBasedOnRegexPattern() {
        final String alphaPattern = "^alpha-.*$";
        final String betaPattern = "^beta-.*$";
        final String alphaModel = "alpha-1";
        final String betaModel = "beta-2";
        BaseLlm alphaLlm = mock(BaseLlm.class);
        BaseLlm betaLlm = mock(BaseLlm.class);
        when(alphaFactory.apply(alphaModel)).thenReturn(alphaLlm);
        when(betaFactory.apply(betaModel)).thenReturn(betaLlm);
        LlmRegistry.registerTestLlm(alphaPattern, alphaFactory);
        LlmRegistry.registerTestLlm(betaPattern, betaFactory);
        BaseLlm actualAlpha = LlmRegistry.getLlm(alphaModel);
        BaseLlm actualBeta = LlmRegistry.getLlm(betaModel);
        Assertions.assertSame((BaseLlm) alphaLlm, (BaseLlm) actualAlpha);
        Assertions.assertSame((BaseLlm) betaLlm, (BaseLlm) actualBeta);
        verify(alphaFactory, times(1)).apply(alphaModel);
        verify(betaFactory, times(1)).apply(betaModel);
        verifyNoInteractions(factory);
    }
    @Test
    @Tag("boundary")
    public void registerTestLlmEvictsCachedInstancesForPattern() {
        final String pattern = "^evict-.*$";
        final String model = "evict-1";
        Function<String, BaseLlm> initialFactory = mock(Function.class);
        BaseLlm initialInstance = mock(BaseLlm.class);
        when(initialFactory.apply(model)).thenReturn(initialInstance);
        LlmRegistry.registerTestLlm(pattern, initialFactory);
        BaseLlm first = LlmRegistry.getLlm(model);
        Assertions.assertSame((BaseLlm) initialInstance, (BaseLlm) first);
        Function<String, BaseLlm> newFactory = mock(Function.class);
        BaseLlm newInstance = mock(BaseLlm.class);
        when(newFactory.apply(model)).thenReturn(newInstance);
        LlmRegistry.registerTestLlm(pattern, newFactory);
        BaseLlm second = LlmRegistry.getLlm(model);
        Assertions.assertSame((BaseLlm) newInstance, (BaseLlm) second);
        Assertions.assertNotSame((BaseLlm) first, (BaseLlm) second);
        verify(initialFactory, times(1)).apply(model);
        verify(newFactory, times(1)).apply(model);
    }
    @Test
    @Tag("integration")
    public void concurrentAccessReturnsSingleInstance() throws InterruptedException {
        final String pattern = "^concurrent-model-.*$";
        final String model = "concurrent-model-1";
        final int threads = 8; // TODO: Adjust the level of concurrency if needed
        BaseLlm expected = mock(BaseLlm.class);
        when(factory.apply(model)).thenReturn(expected);
        LlmRegistry.registerTestLlm(pattern, factory);
        CountDownLatch startLatch = new CountDownLatch(1);
        CountDownLatch doneLatch = new CountDownLatch(threads);
        Map<Integer, BaseLlm> results = new ConcurrentHashMap<>();
        for (int i = 0; i < threads; i++) {
            final int idx = i;
            Thread t = new Thread(() -> {
                try {
                    startLatch.await(5, TimeUnit.SECONDS);
                    BaseLlm result = LlmRegistry.getLlm(model);
                    results.put(idx, result);
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                } finally {
                    doneLatch.countDown();
                }
            });
            t.start();
        }
        startLatch.countDown();
        boolean completed = doneLatch.await(10, TimeUnit.SECONDS);
        Assertions.assertTrue((boolean) completed);
        for (int i = 0; i < threads; i++) {
            BaseLlm actual = results.get(i);
            Assertions.assertNotNull((BaseLlm) actual);
            Assertions.assertSame((BaseLlm) expected, (BaseLlm) actual);
        }
        verify(factory, times(1)).apply(model);
    }
}