public class GeminiLlmConnectionConvertToServerResponseTest {
    @Test
    @Tag("valid")
    public void testServerContentPresentWithAllOptionalsAbsent() {
        LiveServerContent serverContent = LiveServerContent.builder().build();
        LiveServerMessage message = LiveServerMessage.builder().serverContent(Optional.of(serverContent)).build();
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue(result.isPresent());
        LlmResponse response = result.get();
        assertFalse(((Optional<?>) response.content()).isPresent());
        assertEquals(false, ((Optional<?>) response.partial()).orElse(true));
        assertEquals(false, ((Optional<?>) response.turnComplete()).orElse(true));
        assertFalse(((Optional<?>) response.interrupted()).isPresent());
    }
    @Test
    @Tag("valid")
    public void testServerContentWithOnlyModelTurnSet() {
        Content modelTurn = Content.builder().build();
        LiveServerContent serverContent = LiveServerContent.builder().modelTurn(Optional.of(modelTurn)).build();
        LiveServerMessage message = LiveServerMessage.builder().serverContent(Optional.of(serverContent)).build();
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue(result.isPresent());
        LlmResponse response = result.get();
        assertTrue(((Optional<?>) response.content()).isPresent());
        assertEquals(modelTurn, ((Optional<?>) response.content()).get());
        assertEquals(false, ((Optional<?>) response.partial()).orElse(true));
        assertEquals(false, ((Optional<?>) response.turnComplete()).orElse(true));
        assertFalse(((Optional<?>) response.interrupted()).isPresent());
    }
    @Test
    @Tag("valid")
    public void testServerContentWithOnlyTurnCompleteSet() {
        LiveServerContent serverContent = LiveServerContent.builder().turnComplete(Optional.of(true)).build();
        LiveServerMessage message = LiveServerMessage.builder().serverContent(Optional.of(serverContent)).build();
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue(result.isPresent());
        LlmResponse response = result.get();
        assertFalse(((Optional<?>) response.content()).isPresent());
        assertEquals(false, ((Optional<?>) response.partial()).orElse(true));
        assertEquals(true, ((Optional<?>) response.turnComplete()).orElse(false));
        assertFalse(((Optional<?>) response.interrupted()).isPresent());
    }
    @Test
    @Tag("valid")
    public void testServerContentWithOnlyInterruptedSet() {
        LiveServerContent serverContent = LiveServerContent.builder().interrupted(Optional.of(true)).build();
        LiveServerMessage message = LiveServerMessage.builder().serverContent(Optional.of(serverContent)).build();
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue(result.isPresent());
        LlmResponse response = result.get();
        assertFalse(((Optional<?>) response.content()).isPresent());
        assertEquals(false, ((Optional<?>) response.partial()).orElse(true));
        assertEquals(false, ((Optional<?>) response.turnComplete()).orElse(true));
        assertTrue(((Optional<?>) response.interrupted()).isPresent());
        assertEquals(true, ((Optional<?>) response.interrupted()).get());
    }
    @Test
    @Tag("valid")
    public void testToolCallPresentWithEmptyFunctionCalls() {
        LiveServerToolCall toolCall = LiveServerToolCall.builder().functionCalls(Optional.of(ImmutableList.of())).build();
        LiveServerMessage message = LiveServerMessage.builder().toolCall(Optional.of(toolCall)).build();
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue(result.isPresent());
        LlmResponse response = result.get();
        assertFalse(((Optional<?>) response.content()).isPresent());
        assertEquals(false, ((Optional<?>) response.partial()).orElse(true));
        assertEquals(false, ((Optional<?>) response.turnComplete()).orElse(true));
    }
    @Test
