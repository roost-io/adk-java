@ExtendWith(MockitoExtension.class)
public class GeminiLlmConnectionConvertToServerResponseTest {
    @Test
    @Tag("valid")
    public void serverContentWithIncompleteTurnSetsPartialTrue() {
        LiveServerMessage message = Mockito.mock(LiveServerMessage.class);
        LiveServerContent serverContent = Mockito.mock(LiveServerContent.class);
        Content modelTurnContent = Content.builder().parts(ImmutableList.of()).build();
        Mockito.when(serverContent.modelTurn()).thenReturn(Optional.of(modelTurnContent));
        Mockito.when(serverContent.turnComplete()).thenReturn(Optional.of(false));
        Mockito.when(serverContent.interrupted()).thenReturn(Boolean.FALSE);
        Mockito.when(message.serverContent()).thenReturn(Optional.of(serverContent));
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue((boolean) result.isPresent());
        LlmResponse response = result.get();
        assertTrue((boolean) response.partial().isPresent());
        assertEquals((Boolean) Boolean.TRUE, (Boolean) response.partial().get());
        assertTrue((boolean) response.turnComplete().isPresent());
        assertEquals((Boolean) Boolean.FALSE, (Boolean) response.turnComplete().get());
        assertTrue((boolean) response.content().isPresent());
        assertSame((Content) modelTurnContent, (Content) response.content().get());
        assertTrue((boolean) response.interrupted().isPresent());
        assertEquals((Boolean) Boolean.FALSE, (Boolean) response.interrupted().get());
    }
    @Test
    @Tag("valid")
    public void serverContentWithCompleteTurnSetsPartialFalse() {
        LiveServerMessage message = Mockito.mock(LiveServerMessage.class);
        LiveServerContent serverContent = Mockito.mock(LiveServerContent.class);
        Content modelTurnContent = Content.builder().parts(ImmutableList.of()).build();
        Mockito.when(serverContent.modelTurn()).thenReturn(Optional.of(modelTurnContent));
        Mockito.when(serverContent.turnComplete()).thenReturn(Optional.of(true));
        Mockito.when(serverContent.interrupted()).thenReturn(Boolean.TRUE);
        Mockito.when(message.serverContent()).thenReturn(Optional.of(serverContent));
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue((boolean) result.isPresent());
        LlmResponse response = result.get();
        assertTrue((boolean) response.partial().isPresent());
        assertEquals((Boolean) Boolean.FALSE, (Boolean) response.partial().get());
        assertTrue((boolean) response.turnComplete().isPresent());
        assertEquals((Boolean) Boolean.TRUE, (Boolean) response.turnComplete().get());
        assertTrue((boolean) response.content().isPresent());
        assertSame((Content) modelTurnContent, (Content) response.content().get());
        assertTrue((boolean) response.interrupted().isPresent());
        assertEquals((Boolean) Boolean.TRUE, (Boolean) response.interrupted().get());
    }
    @Test
    @Tag("boundary")
    public void serverContentWithoutTurnCompleteDefaultsFalse() {
        LiveServerMessage message = Mockito.mock(LiveServerMessage.class);
        LiveServerContent serverContent = Mockito.mock(LiveServerContent.class);
        Mockito.when(serverContent.modelTurn()).thenReturn(Optional.empty());
        Mockito.when(serverContent.turnComplete()).thenReturn(Optional.empty());
        Mockito.when(serverContent.interrupted()).thenReturn(Boolean.FALSE);
        Mockito.when(message.serverContent()).thenReturn(Optional.of(serverContent));
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue((boolean) result.isPresent());
        LlmResponse response = result.get();
        assertTrue((boolean) response.partial().isPresent());
        assertEquals((Boolean) Boolean.FALSE, (Boolean) response.partial().get());
        assertTrue((boolean) response.turnComplete().isPresent());
        assertEquals((Boolean) Boolean.FALSE, (Boolean) response.turnComplete().get());
        assertFalse((boolean) response.content().isPresent());
        assertTrue((boolean) response.interrupted().isPresent());
        assertEquals((Boolean) Boolean.FALSE, (Boolean) response.interrupted().get());
    }
    @Test
    @Tag("valid")
    public void toolCallProducesContentAndFlagsFalse() {
        LiveServerMessage message = Mockito.mock(LiveServerMessage.class);
        LiveServerToolCall toolCall = Mockito.mock(LiveServerToolCall.class);
        FunctionCall functionCall = Mockito.mock(FunctionCall.class);
        List<FunctionCall> calls = ImmutableList.of(functionCall);
        Mockito.when(toolCall.functionCalls()).thenReturn(Optional.of(calls));
        Mockito.when(message.toolCall()).thenReturn(Optional.of(toolCall));
        Mockito.when(message.serverContent()).thenReturn(Optional.empty());
        Mockito.when(message.usageMetadata()).thenReturn(Optional.empty());
        Mockito.when(message.toolCallCancellation()).thenReturn(Optional.empty());
        Mockito.when(message.setupComplete()).thenReturn(Optional.empty());
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue((boolean) result.isPresent());
        LlmResponse response = result.get();
        assertTrue((boolean) response.partial().isPresent());
        assertEquals((Boolean) Boolean.FALSE, (Boolean) response.partial().get());
        assertTrue((boolean) response.turnComplete().isPresent());
        assertEquals((Boolean) Boolean.FALSE, (Boolean) response.turnComplete().get());
        assertTrue((boolean) response.content().isPresent());
        Content content = response.content().get();
        Optional<List<Part>> partsOpt = content.parts();
        assertTrue((boolean) partsOpt.isPresent());
        List<Part> parts = partsOpt.get();
        assertEquals((int) 1, (int) parts.size());
        Part part = parts.get(0);
        assertTrue((boolean) part.functionCall().isPresent());
        assertSame((FunctionCall) functionCall, (FunctionCall) part.functionCall().get());
    }
