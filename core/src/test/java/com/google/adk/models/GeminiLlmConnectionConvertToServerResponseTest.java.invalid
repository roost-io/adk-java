    @Test
    @Tag("boundary")
    public void testServerContentWithModelTurnContainingMultipleParts() {
        Part part1 = Part.builder().build();
        Part part2 = Part.builder().build();
        Content modelTurn = Content.builder().parts(Optional.of(ImmutableList.of(part1, part2))).build();
        LiveServerContent serverContent = LiveServerContent.builder().modelTurn(Optional.of(modelTurn)).build();
        LiveServerMessage message = LiveServerMessage.builder().serverContent(Optional.of(serverContent)).build();
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue(result.isPresent());
        LlmResponse response = result.get();
        assertTrue(((Optional<?>) response.content()).isPresent());
        Content content = ((Optional<Content>) response.content()).get();
        assertTrue(((Optional<?>) content.parts()).isPresent());
        List<?> parts = ((Optional<?>) content.parts()).get();
        assertEquals(2, parts.size());
        assertEquals(part1, parts.get(0));
        assertEquals(part2, parts.get(1));
    }
