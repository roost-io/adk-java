        Tool tool = mock(Tool.class);
        ToolUnion toolUnion = ToolUnion.ofTool(tool);
        List<ToolUnion> toolUnions = List.of(toolUnion);
        GenerateContentConfig.Tools toolsStruct = mock(GenerateContentConfig.Tools.class);
        when(toolsStruct.functionDeclarations()).thenReturn(Optional.of(funcList));
        List<GenerateContentConfig.Tools> toolsStructList = List.of(toolsStruct);
        GenerateContentConfig config = mock(GenerateContentConfig.class);
        when(config.tools()).thenReturn(Optional.of(toolsStructList));
        when(config.systemInstruction()).thenReturn(Optional.empty());
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.config()).thenReturn(Optional.of(config));
        when(llmRequest.tools()).thenReturn(ImmutableMap.of("fake", mock(BaseTool.class)));
        when(llmRequest.contents()).thenReturn(ImmutableList.of());
        when(llmRequest.model()).thenReturn(Optional.of("my-model"));
        Message message = mock(Message.class);
        stubMessagesCreateReturn(message);
        Claude spyClaude = spy(claude);
        MessageParam fakeMsgParam = mock(MessageParam.class);
        doReturn(fakeMsgParam).when(spyClaude).contentToAnthropicMessageParam(any());
        doReturn(tool).when(spyClaude).functionDeclarationToAnthropicTool(funcDecl);
