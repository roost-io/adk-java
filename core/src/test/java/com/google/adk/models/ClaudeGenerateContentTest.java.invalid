        assertEquals("default-claude-model", (String) modelStr, "Should fallback to Claude's default model when request model is missing");
        TestSubscriber<LlmResponse> ts = new TestSubscriber<>();
        result.subscribe(ts);
        ts.assertComplete();
        ts.assertNoErrors();
        ts.assertValueCount(1);
