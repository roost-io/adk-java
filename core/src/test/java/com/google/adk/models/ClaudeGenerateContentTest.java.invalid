@ExtendWith(MockitoExtension.class)
public class ClaudeGenerateContentTest {
    private Content mockTextContent(String role, List<String> texts) {
        Content content = Mockito.mock(Content.class);
        List<Part> parts = new ArrayList<>();
        for (String txt : texts) {
            Part p = Mockito.mock(Part.class);
            Mockito.when(p.text()).thenReturn(Optional.of(txt));
            parts.add(p);
        }
        Mockito.when(content.role()).thenReturn(Optional.of(role));
        Mockito.when(content.parts()).thenReturn(Optional.of(parts));
        return content;
    }
    private GenerateContentConfig mockSystemConfig(List<String> systemTexts) {
        GenerateContentConfig cfg = Mockito.mock(GenerateContentConfig.class);
        Content sysContent = Mockito.mock(Content.class);
        List<Part> sysParts = new ArrayList<>();
        for (String t : systemTexts) {
            Part p = Mockito.mock(Part.class);
            Mockito.when(p.text()).thenReturn(Optional.of(t));
            sysParts.add(p);
        }
        Mockito.when(sysContent.parts()).thenReturn(Optional.of(sysParts));
        Mockito.when(cfg.systemInstruction()).thenReturn(Optional.of(sysContent));
        Mockito.when(cfg.tools()).thenReturn(Optional.empty());
        return cfg;
    }
    @Test
    @Tag("integration")
    public void buildsMessageParamsFromTextOnlyContents() {
        AnthropicClient anthropicClient = Mockito.mock(AnthropicClient.class, Mockito.RETURNS_DEEP_STUBS);
        // TODO: Change model if required by your environment or configuration
        Claude claude = new Claude("test-model", anthropicClient);
        Content c1 = mockTextContent("user", Arrays.asList("Hello world"));
        Content c2 = mockTextContent("user", Arrays.asList("How are you?"));
        List<Content> contents = Arrays.asList(c1, c2);
        LlmRequest llmRequest = Mockito.mock(LlmRequest.class);
        Mockito.when(llmRequest.contents()).thenReturn(contents);
        Mockito.when(llmRequest.config()).thenReturn(Optional.empty());
        Mockito.when(llmRequest.tools()).thenReturn(Optional.empty());
        Mockito.when(llmRequest.model()).thenReturn(Optional.of("user-provided-model"));
        Message mockedMessage = Mockito.mock(Message.class);
        ArgumentCaptor<MessageCreateParams> captor = ArgumentCaptor.forClass(MessageCreateParams.class);
        Mockito.when(anthropicClient.messages().create(captor.capture())).thenReturn(mockedMessage);
        Flowable<LlmResponse> result = claude.generateContent(llmRequest, false);
        TestSubscriber<LlmResponse> ts = new TestSubscriber<>();
        result.subscribe(ts);
        ts.assertNoErrors();
        ts.assertComplete();
        ts.assertValueCount(1);
        Mockito.verify(anthropicClient, Mockito.times(1)).messages().create(Mockito.any(MessageCreateParams.class));
        MessageCreateParams params = captor.getValue();
        List<MessageParam> paramsMessages = params.messages();
        int expectedSize = (int) contents.size();
        int actualSize = (int) paramsMessages.size();
        org.junit.jupiter.api.Assertions.assertEquals((int) expectedSize, (int) actualSize);
        // Validate that each message has non-null content container per SDK union type
        for (int i = 0; i < paramsMessages.size(); i++) {
            MessageParam mp = paramsMessages.get(i);
            org.junit.jupiter.api.Assertions.assertNotNull((Object) mp.content());
        }
    }
    @Test
    @Tag("valid")
    public void setsSystemInstructionFromConfigParts() {
        AnthropicClient anthropicClient = Mockito.mock(AnthropicClient.class, Mockito.RETURNS_DEEP_STUBS);
        // TODO: Change model if required by your environment or configuration
        Claude claude = new Claude("test-model", anthropicClient);
        Content c1 = mockTextContent("user", Arrays.asList("Tell me a joke."));
        List<Content> contents = Arrays.asList(c1);
        GenerateContentConfig cfg = mockSystemConfig(Arrays.asList("You are helpful.", "Respond concisely."));
        LlmRequest llmRequest = Mockito.mock(LlmRequest.class);
        Mockito.when(llmRequest.contents()).thenReturn(contents);
        Mockito.when(llmRequest.config()).thenReturn(Optional.of(cfg));
        Mockito.when(llmRequest.tools()).thenReturn(Optional.empty());
        Mockito.when(llmRequest.model()).thenReturn(Optional.of("configured-model"));
        Message mockedMessage = Mockito.mock(Message.class);
        ArgumentCaptor<MessageCreateParams> captor = ArgumentCaptor.forClass(MessageCreateParams.class);
        Mockito.when(anthropicClient.messages().create(captor.capture())).thenReturn(mockedMessage);
        Flowable<LlmResponse> result = claude.generateContent(llmRequest, false);
        TestSubscriber<LlmResponse> ts = new TestSubscriber<>();
        result.subscribe(ts);
        ts.assertNoErrors();
        ts.assertComplete();
        ts.assertValueCount(1);
        MessageCreateParams params = captor.getValue();
        Optional<?> sysOpt = params.system();
        org.junit.jupiter.api.Assertions.assertTrue((boolean) sysOpt.isPresent());
        String expectedSystem = String.join("\n", Arrays.asList("You are helpful.", "Respond concisely."));
        String sysStr = sysOpt.get().toString();
        org.junit.jupiter.api.Assertions.assertTrue((boolean) sysStr.contains(expectedSystem));
        int expectedMsgs = (int) contents.size();
        int actualMsgs = (int) params.messages().size();
        org.junit.jupiter.api.Assertions.assertEquals((int) expectedMsgs, (int) actualMsgs);
    }
    @Test
    @Tag("invalid")
    public void throwsWhenAnthropicCreateFails() {
        AnthropicClient anthropicClient = Mockito.mock(AnthropicClient.class, Mockito.RETURNS_DEEP_STUBS);
        // TODO: Change model if required by your environment or configuration
        Claude claude = new Claude("test-model", anthropicClient);
        Content c1 = mockTextContent("user", Arrays.asList("Ping"));
        List<Content> contents = Arrays.asList(c1);
        LlmRequest llmRequest = Mockito.mock(LlmRequest.class);
        Mockito.when(llmRequest.contents()).thenReturn(contents);
        Mockito.when(llmRequest.config()).thenReturn(Optional.empty());
        Mockito.when(llmRequest.tools()).thenReturn(Optional.empty());
        Mockito.when(llmRequest.model()).thenReturn(Optional.of("failing-model"));
        Mockito.when(anthropicClient.messages().create(Mockito.any(MessageCreateParams.class)))
            .thenThrow(new RuntimeException("Service unavailable"));
        org.junit.jupiter.api.Assertions.assertThrows(RuntimeException.class, () -> {
            claude.generateContent(llmRequest, false);
        });
    }
    @Test
    @Tag("boundary")
    public void usesProvidedModelAndMaxTokens() {
        AnthropicClient anthropicClient = Mockito.mock(AnthropicClient.class, Mockito.RETURNS_DEEP_STUBS);
        int customMaxTokens = 1024; // boundary-like configuration
        // TODO: Change model if required by your environment or configuration
        Claude claude = new Claude("test-model", anthropicClient, customMaxTokens);
        Content c1 = mockTextContent("user", Arrays.asList("Provide summary."));
        List<Content> contents = Arrays.asList(c1);
        LlmRequest llmRequest = Mockito.mock(LlmRequest.class);
        Mockito.when(llmRequest.contents()).thenReturn(contents);
        Mockito.when(llmRequest.config()).thenReturn(Optional.empty());
        Mockito.when(llmRequest.tools()).thenReturn(Optional.empty());
        Mockito.when(llmRequest.model()).thenReturn(Optional.of("explicit-model"));
        Message mockedMessage = Mockito.mock(Message.class);
        ArgumentCaptor<MessageCreateParams> captor = ArgumentCaptor.forClass(MessageCreateParams.class);
        Mockito.when(anthropicClient.messages().create(captor.capture())).thenReturn(mockedMessage);
        Flowable<LlmResponse> result = claude.generateContent(llmRequest, false);
        TestSubscriber<LlmResponse> ts = new TestSubscriber<>();
        result.subscribe(ts);
        ts.assertNoErrors();
        ts.assertComplete();
        ts.assertValueCount(1);
        MessageCreateParams params = captor.getValue();
        String modelUsed = params.model().toString();
        org.junit.jupiter.api.Assertions.assertEquals((String) "explicit-model", (String) modelUsed);
        long mt = params.maxTokens();
        org.junit.jupiter.api.Assertions.assertEquals((long) customMaxTokens, (long) mt);
    }
