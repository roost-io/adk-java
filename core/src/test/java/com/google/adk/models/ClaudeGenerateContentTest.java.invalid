  private Part mockFunctionCallPart(String id, String name, Map<String, Object> args) {
    Part part = Mockito.mock(Part.class);
    FunctionCall fc = Mockito.mock(FunctionCall.class);
    when(fc.id()).thenReturn(Optional.ofNullable(id));
    when(fc.name()).thenReturn(Optional.ofNullable(name));
    when(fc.args()).thenReturn(Optional.ofNullable(args));
    when(part.functionCall()).thenReturn(Optional.of(fc));
    when(part.text()).thenReturn(Optional.empty());
