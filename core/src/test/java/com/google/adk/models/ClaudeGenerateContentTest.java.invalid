    @Test
    @Tag("valid")
    public void testGenerateContentWithMinimalLlmRequest() {
        Part part = mock(Part.class);
        when(part.text()).thenReturn(Optional.of("Hello Claude"));
        Content content = mock(Content.class);
        when(content.role()).thenReturn("user");
        when(content.parts()).thenReturn(Optional.of(ImmutableList.of(part)));
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.model()).thenReturn(Optional.of("claude-2"));
        when(llmRequest.contents()).thenReturn(ImmutableList.of(content));
        when(llmRequest.config()).thenReturn(Optional.empty());
        when(llmRequest.tools()).thenReturn(Collections.emptyList());
        Message anthropicMessage = mock(Message.class);
        when(((AnthropicClient.Messages) anthropicMessages).create(any())).thenReturn(anthropicMessage);
        LlmResponse expectedResponse = mock(LlmResponse.class);
        doReturn(expectedResponse).when(claude).convertAnthropicResponseToLlmResponse(anthropicMessage);
        Flowable<LlmResponse> resultFlowable = claude.generateContent(llmRequest, false);
        verify((AnthropicClient.Messages) anthropicMessages).create(paramsCaptor.capture());
        MessageCreateParams usedParams = paramsCaptor.getValue();
        assertEquals("claude-2", (String)usedParams.model());
        assertEquals("", (String)usedParams.system());
        assertEquals(ImmutableList.of(), (List<?>)usedParams.tools());
        assertEquals(8192, (int)usedParams.maxTokens());
        assertNotNull(usedParams.messages());
        resultFlowable.test().assertValue(expectedResponse);
    }
