    @Test
    @Tag("valid")
    void testGenerateContentWithoutToolsAndSystemInstructions() {
        Content userContent = Content.builder()
                .role("user")
                .parts(ImmutableList.of(Part.builder().text(Optional.of("How are you?")).build()))
                .build();
        LlmRequest llmRequest = baseLlmRequestWithContents(ImmutableList.of(userContent));
        Message message = mock(Message.class);
        when(((AnthropicClient) anthropicMessages).create(any())).thenReturn(message);
        LlmResponse expectedResponse = responseFromMessage(message);
        doReturn(responseFromMessage(message)).when(claude).convertAnthropicResponseToLlmResponse(message);
        Flowable<LlmResponse> respFlow = claude.generateContent(llmRequest, false);
        LlmResponse actual = respFlow.blockingFirst();
        assertEquals((Object) expectedResponse, (Object) actual);
    }
    @Test
    @Tag("valid")
    void testGenerateContentWithToolsAndToolChoice() {
        FunctionDeclaration fnDecl = new FunctionDeclaration("f1", Optional.empty(), Optional.empty()); 
        List<FunctionDeclaration> fnDeclList = ImmutableList.of(fnDecl);
        GenerateContentConfig.ToolConfig toolConfig = GenerateContentConfig.ToolConfig.builder()
                .functionDeclarations(Optional.of(fnDeclList))
                .build();
        GenerateContentConfig config = GenerateContentConfig.builder()
                .tools(Optional.of(ImmutableList.of(toolConfig)))
                .build();
        LlmRequest llmRequest = LlmRequest.builder()
                .contents(ImmutableList.of(
                        Content.builder().role("user").parts(ImmutableList.of(Part.builder().text(Optional.of("Q")).build())).build()))
                .tools(ImmutableMap.of("t", mock(BaseTool.class)))
                .config(Optional.of(config))
                .build();
        Tool anthropicTool = mock(Tool.class);
        doReturn(anthropicTool).when(claude).functionDeclarationToAnthropicTool(fnDecl);
        Message message = mock(Message.class);
        when(((AnthropicClient) anthropicMessages).create(any())).thenReturn(message);
        doReturn(responseFromMessage(message)).when(claude).convertAnthropicResponseToLlmResponse(message);
        claude.generateContent(llmRequest, false).blockingFirst();
        ArgumentCaptor<MessageCreateParams> paramsCaptor = ArgumentCaptor.forClass(MessageCreateParams.class);
        verify(((AnthropicClient)anthropicMessages), times(1)).create(paramsCaptor.capture());
        MessageCreateParams actualParams = paramsCaptor.getValue();
        assertEquals(1, (int) actualParams.tools().size());
        assertNotNull(actualParams.toolChoice());
        assertEquals((Object) ToolChoice.class, (Object) actualParams.toolChoice().getClass());
    }
