  private Message mockAnthropicMessageWithText(String text) {
    Message message = Mockito.mock(Message.class);
    ContentBlock textBlock = Mockito.mock(ContentBlock.class, AdditionalAnswers.delegatesTo(new Object() {}));
    when(textBlock.type()).thenReturn("text");
    // Create a concrete TextBlockParam-like behavior via mocking the interface it implements
    ContentBlock contentBlock = Mockito.mock(ContentBlock.class);
    when(contentBlock.type()).thenReturn("text");
    when(contentBlock.toString()).thenReturn(text);
    @SuppressWarnings("unchecked")
    List<ContentBlock> blocks = new ArrayList<>();
    blocks.add(contentBlock);
    when(message.content()).thenReturn(blocks);
    return message;
  }
  private Message mockAnthropicMessageWithBlocks(List<ContentBlock> blocks) {
    Message message = Mockito.mock(Message.class);
    when(message.content()).thenReturn(blocks);
    return message;
  }
  private AnthropicClient mockDeepAnthropicClientReturning(Message msg) {
    AnthropicClient deep = Mockito.mock(AnthropicClient.class, Mockito.RETURNS_DEEP_STUBS);
    when(deep.messages().create(any(MessageCreateParams.class))).thenReturn(msg);
    return deep;
  }
  private LlmRequest mockRequest(Optional<String> modelOpt, List<Content> contents, Optional<GenerateContentConfig> configOpt, Map tools) {
    LlmRequest req = Mockito.mock(LlmRequest.class);
    when(req.model()).thenReturn(modelOpt);
    when(req.contents()).thenReturn(contents);
    when(req.config()).thenReturn(configOpt);
    LiveConnectConfig liveConnectConfig = LiveConnectConfig.builder().build();
    when(req.liveConnectConfig()).thenReturn(liveConnectConfig);
    when(req.tools()).thenReturn((Map) tools);
    return req;
