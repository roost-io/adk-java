    @Test
    @Tag("valid")
    public void testGenerateContentWithValidRequest() {
        LlmRequest llmRequest = LlmRequest.builder()
                .contents(List.of(Content.builder().role("user").parts(ImmutableList.of(Part.builder().text("Hello").build())).build()))
                .config(Optional.of(GenerateContentConfig.builder().systemInstruction(Optional.of(Content.builder().parts(ImmutableList.of(Part.builder().text("System instruction").build())).build())).build()))
                .build();
        Message mockMessage = new Message();
        when(anthropicClient.messages().create(any(MessageCreateParams.class))).thenReturn(mockMessage);
        Flowable<LlmResponse> responseFlowable = claude.generateContent(llmRequest, false);
        responseFlowable.test()
                .assertValue(response -> response.content().role().equals("model"))
                .assertComplete();
    }
