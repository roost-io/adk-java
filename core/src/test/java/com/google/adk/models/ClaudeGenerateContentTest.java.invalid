    @Test
    @Tag("boundary")
    void testGenerateContentStreamingParameterIsIgnored() {
        Content userContent = Content.builder()
                .role("user")
                .parts(ImmutableList.of(Part.builder().text(Optional.of("foo")).build()))
                .build();
        LlmRequest llmRequest = baseLlmRequestWithContents(ImmutableList.of(userContent));
        Message message = mock(Message.class);
        when(((AnthropicClient) anthropicMessages).create(any())).thenReturn(message);
        LlmResponse expectedResponse = responseFromMessage(message);
        doReturn(responseFromMessage(message)).when(claude).convertAnthropicResponseToLlmResponse(message);
        LlmResponse respFalse = claude.generateContent(llmRequest, false).blockingFirst();
        LlmResponse respTrue = claude.generateContent(llmRequest, true).blockingFirst();
        assertEquals((Object) expectedResponse, (Object) respFalse);
        assertEquals((Object) expectedResponse, (Object) respTrue);
    }
    @Test
    @Tag("integration")
    void testGenerateContentMapsAnthropicResponseToLlmResponse() {
        Message message = mock(Message.class);
        ContentBlock cb1 = mock(ContentBlock.class);
        ContentBlock cb2 = mock(ContentBlock.class);
        List<ContentBlock> contentBlocks = ImmutableList.of(cb1, cb2);
        when(message.content()).thenReturn(contentBlocks);
        Part part1 = Part.builder().text(Optional.of("txt")).build();
        Part part2 = Part.builder().functionCall(Optional.of(FunctionCall.builder().name("fnA").build())).build();
        doReturn(part1).when(claude).anthropicContentBlockToPart(cb1);
        doReturn(part2).when(claude).anthropicContentBlockToPart(cb2);
        LlmRequest llmRequest = baseLlmRequestWithContents(ImmutableList.of(Content.builder().role("user").parts(ImmutableList.of(Part.builder().text(Optional.of("ask")).build())).build()));
        when(((AnthropicClient) anthropicMessages).create(any())).thenReturn(message);
        Flowable<LlmResponse> respFlow = claude.generateContent(llmRequest, false);
        LlmResponse resp = respFlow.blockingFirst();
        assertTrue(resp.content().isPresent());
        Content respContent = resp.content().get();
        assertEquals((Object) "model", (Object) respContent.role());
        assertEquals(2, respContent.parts().map(List::size).orElse(0));
    }
