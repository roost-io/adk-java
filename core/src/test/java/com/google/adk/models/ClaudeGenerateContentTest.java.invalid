    @Mock(answer = Answers.RETURNS_DEEP_STUBS)
    private AnthropicClient anthropicClient;
    @Captor
    private ArgumentCaptor<MessageCreateParams> messageCreateParamsCaptor;
    private Claude newClaude() {
        String modelName = "test-model"; // TODO change default model name if needed
        return new Claude(modelName, anthropicClient);
    }
    private Claude newClaudeWithMaxTokens(int maxTokens) {
        String modelName = "test-model"; // TODO change default model name if needed
        return new Claude(modelName, anthropicClient, maxTokens);
    }
    // Modified to avoid referencing BaseTool which is not available in the compilation unit
    private LlmRequest mockTextOnlyLlmRequest(List<com.google.genai.types.Content> contents, Optional<String> modelOpt, Optional<com.google.genai.types.GenerateContentConfig> configOpt, Map tools) {
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.contents()).thenReturn(contents);
        when(llmRequest.model()).thenReturn(modelOpt);
        when(llmRequest.config()).thenReturn(configOpt);
        when(llmRequest.tools()).thenReturn((Map) tools);
        // liveConnectConfig() must be returned; using a mock that is not null
        LiveConnectConfig liveConnectConfig = mock(LiveConnectConfig.class);
        when(llmRequest.liveConnectConfig()).thenReturn(liveConnectConfig);
        return llmRequest;
    }
    private com.google.genai.types.Content mockContent(String role, List<com.google.genai.types.Part> parts) {
        com.google.genai.types.Content content = mock(com.google.genai.types.Content.class);
        when(content.role()).thenReturn(Optional.ofNullable(role));
        when(content.parts()).thenReturn(Optional.of(parts));
        return content;
    }
    private com.google.genai.types.Part mockTextPart(String text) {
        com.google.genai.types.Part part = mock(com.google.genai.types.Part.class);
        when(part.text()).thenReturn(Optional.ofNullable(text));
        when(part.functionCall()).thenReturn(Optional.empty());
        when(part.functionResponse()).thenReturn(Optional.empty());
        return part;
    }
    private Message mockAnthropicTextMessage(String text) {
        Message message = mock(Message.class);
        ContentBlock textBlock = mock(ContentBlock.class, Answers.RETURNS_DEEP_STUBS);
        when(textBlock.isText()).thenReturn(true);
        when(textBlock.asText().text()).thenReturn(text);
        when(message.content()).thenReturn(java.util.List.of(textBlock));
        return message;
    }
    @Test
    @Tag("valid")
    public void testBuildsMessageParamsFromTextOnlyContents() {
        // Arrange
        com.google.genai.types.Part p1 = mockTextPart("Hello");
        com.google.genai.types.Part p2 = mockTextPart("World");
        com.google.genai.types.Content content = mockContent("user", com.google.common.collect.ImmutableList.of(p1, p2));
        LlmRequest llmRequest = mockTextOnlyLlmRequest(
                com.google.common.collect.ImmutableList.of(content),
                Optional.of("unit-model"),
                Optional.empty(),
                com.google.common.collect.ImmutableMap.of()
        );
        Message message = mockAnthropicTextMessage("ok");
        when(anthropicClient.messages().create(any(MessageCreateParams.class))).thenReturn(message);
        Claude claude = newClaude();
        // Act
        Flowable<LlmResponse> flow = claude.generateContent(llmRequest, false);
        // Assert MessageCreateParams
        verify(anthropicClient.messages(), times(1)).create(messageCreateParamsCaptor.capture());
        MessageCreateParams captured = messageCreateParamsCaptor.getValue();
        assertNotNull(captured, "MessageCreateParams should not be null");
        List<MessageParam> msgs = captured.messages();
        assertNotNull(msgs, "messages should not be null");
        assertEquals(1, (int) msgs.size(), "messages count should match contents count");
        MessageParam mp = msgs.get(0);
        assertNotNull(mp, "MessageParam should not be null");
        assertEquals(Role.USER, mp.role(), "Role should map 'user' to Role.USER");
        List<ContentBlockParam> blocks = mp.content();
        assertNotNull(blocks, "Content blocks should not be null");
        assertEquals(2, (int) blocks.size(), "Should produce one text block per input text Part");
        // Verify each text block has the expected text in order
        ContentBlockParam b0 = blocks.get(0);
        ContentBlockParam b1 = blocks.get(1);
        assertTrue(b0.isText(), "First block should be text");
        assertTrue(b1.isText(), "Second block should be text");
        assertEquals("Hello", b0.asText().text(), "First block text should match Part text");
        assertEquals("World", b1.asText().text(), "Second block text should match Part text");
        // Assert Flowable emits exactly one LlmResponse and completes
        TestSubscriber<LlmResponse> ts = flow.test();
        ts.assertValueCount(1);
        ts.assertValue(v -> v != null);
        ts.assertComplete();
        ts.assertNoErrors();
    }
    @Test
    @Tag("valid")
    public void testSetsSystemInstructionWhenPresentAndToolChoiceWhenToolsNotEmpty() {
        // Arrange system instruction
        com.google.genai.types.Part sysP1 = mockTextPart("sys-one");
        com.google.genai.types.Part sysP2 = mockTextPart("sys-two");
        com.google.genai.types.Content sysContent = mockContent("system", com.google.common.collect.ImmutableList.of(sysP1, sysP2));
        com.google.genai.types.GenerateContentConfig config = mock(com.google.genai.types.GenerateContentConfig.class);
        when(config.systemInstruction()).thenReturn(Optional.of(sysContent));
        // Leave tools empty/absent to avoid schema complexity in this test
        when(config.tools()).thenReturn(Optional.empty());
        // Arrange request content
        com.google.genai.types.Part p = mockTextPart("payload");
        com.google.genai.types.Content content = mockContent("user", com.google.common.collect.ImmutableList.of(p));
        // Use raw Map to avoid BaseTool dependency; only emptiness is checked by business logic
        Map tools = new HashMap();
        tools.put("t", new Object());
        LlmRequest llmRequest = mockTextOnlyLlmRequest(
                com.google.common.collect.ImmutableList.of(content),
                Optional.empty(), // force fallback model
                Optional.of(config),
                tools // non-empty tools to enable toolChoice
        );
        Message message = mockAnthropicTextMessage("ok");
        when(anthropicClient.messages().create(any(MessageCreateParams.class))).thenReturn(message);
        Claude claude = newClaude();
        // Act
        Flowable<LlmResponse> flow = claude.generateContent(llmRequest, false);
        // Assert parameters
        verify(anthropicClient.messages(), times(1)).create(messageCreateParamsCaptor.capture());
        MessageCreateParams captured = messageCreateParamsCaptor.getValue();
        assertNotNull(captured, "MessageCreateParams should not be null");
        assertEquals("test-model", captured.model(), "Should use Claude's fallback model when request.model() is empty");
        assertEquals("sys-one\nsys-two", captured.system(), "System text should concatenate system instruction parts");
        ToolChoice toolChoice = captured.toolChoice();
        assertNotNull(toolChoice, "ToolChoice should be set when llmRequest.tools() is not empty");
        // Flow emission
        TestSubscriber<LlmResponse> ts = flow.test();
        ts.assertValueCount(1);
        ts.assertComplete();
        ts.assertNoErrors();
    }
