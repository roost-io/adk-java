    @Test
    @Tag("invalid")
    void testGenerateContentHandlesAnthropicClientException() {
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.contents()).thenReturn(ImmutableList.of());
        when(llmRequest.config()).thenReturn(Optional.empty());
        when(llmRequest.tools()).thenReturn(ImmutableMap.of());
        when(llmRequest.model()).thenReturn(Optional.of("claude-3"));
        RuntimeException anthroEx = new RuntimeException("Anthropic error");
        AnthropicClient.Messages messagesClient = mock(AnthropicClient.Messages.class);
        when(messagesClient.create(any())).thenThrow(anthroEx);
        when(anthropicClient.messages()).thenReturn(messagesClient);
        Claude spyClaude = spy(claude);
        doReturn(mock(LlmResponse.class)).when(spyClaude).convertAnthropicResponseToLlmResponse(any());
        doReturn(messagesClient).when(spyClaude.anthropicClient).messages();
        try {
            spyClaude.generateContent(llmRequest, false).blockingFirst();
            fail("Exception was not propagated as expected");
        } catch (RuntimeException ex) {
            assertSame(anthroEx, ex);
        }
    }
    @Test
    @Tag("valid")
    void testGenerateContentHandlesFunctionResponseParts() {
        Part functionRespPart = mock(Part.class);
        when(functionRespPart.text()).thenReturn(Optional.empty());
        Content content = mock(Content.class);
        when(content.role()).thenReturn("user");
        when(content.parts()).thenReturn(Optional.of(ImmutableList.of(functionRespPart)));
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.contents()).thenReturn(ImmutableList.of(content));
        when(llmRequest.config()).thenReturn(Optional.empty());
        when(llmRequest.tools()).thenReturn(ImmutableMap.of());
        when(llmRequest.model()).thenReturn(Optional.of("claude-3"));
        MessageParam messageParam = mock(MessageParam.class);
        Message message = mock(Message.class);
        stubMessagesCreateReturn(message);
        Claude spyClaude = spy(claude);
        doReturn(messageParam).when(spyClaude).contentToAnthropicMessageParam(any());
        LlmResponse expected = mock(LlmResponse.class);
        doReturn(expected).when(spyClaude).convertAnthropicResponseToLlmResponse(message);
        AnthropicClient.Messages messagesClient = anthropicClient.messages();
        when(messagesClient.create(any())).thenReturn(message);
        doReturn(messagesClient).when(spyClaude.anthropicClient).messages();
        List<LlmResponse> out = spyClaude.generateContent(llmRequest, false).toList().blockingGet();
        assertSame(expected, out.get(0));
        verify(spyClaude).contentToAnthropicMessageParam(content);
    }
    @Test
    @Tag("boundary")
    void testGenerateContentHandlesLargeNumbersOfContentParts() {
        int N = 2000;
        List<Content> contents = new ArrayList<>();
        List<MessageParam> msgParams = new ArrayList<>();
        Claude spyClaude = spy(claude);
        for (int i = 0; i < N; i++) {
            Content c = mock(Content.class);
            contents.add(c);
            MessageParam mp = mock(MessageParam.class);
            msgParams.add(mp);
            doReturn(mp).when(spyClaude).contentToAnthropicMessageParam(c);
        }
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.contents()).thenReturn(contents);
        when(llmRequest.config()).thenReturn(Optional.empty());
        when(llmRequest.tools()).thenReturn(ImmutableMap.of());
        when(llmRequest.model()).thenReturn(Optional.empty());
        Message message = mock(Message.class);
        stubMessagesCreateReturn(message);
        doReturn(mock(LlmResponse.class)).when(spyClaude).convertAnthropicResponseToLlmResponse(message);
        AnthropicClient.Messages messagesClient = anthropicClient.messages();
        when(messagesClient.create(any())).thenReturn(message);
        doReturn(messagesClient).when(spyClaude.anthropicClient).messages();
        spyClaude.generateContent(llmRequest, false).toList().blockingGet();
        verify(messagesClient).create(messageCreateParamsCaptor.capture());
        assertEquals(N, ((MessageCreateParams)messageCreateParamsCaptor.getValue()).messages().size());
    }
