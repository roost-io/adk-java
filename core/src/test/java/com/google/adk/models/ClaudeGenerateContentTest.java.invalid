    return config;
  }
  private com.google.genai.types.Tool mockConfigToolWithFunctionDecls(List<FunctionDeclaration> decls) {
    com.google.genai.types.Tool t = Mockito.mock(com.google.genai.types.Tool.class);
    when(t.functionDeclarations()).thenReturn(Optional.of(decls));
    return t;
  }
  private FunctionDeclaration mockFunctionDeclaration(String name, Map<String, Object> schema) {
    FunctionDeclaration fd = Mockito.mock(FunctionDeclaration.class);
    when(fd.name()).thenReturn(Optional.ofNullable(name));
    when(fd.parameters()).thenReturn(Optional.ofNullable(schema));
    return fd;
  }
