    @Test
    @Tag("integration")
    public void testGenerateContentFillsAllBuilderFieldsCorrectly() {
        int maxTokens = 1234;
        Claude localClaude = Mockito.spy(new Claude("local-model", anthropicClient, maxTokens));
        Part textPart = mock(Part.class);
        when(textPart.text()).thenReturn(Optional.of("hello"));
        Content content = mock(Content.class);
        when(content.role()).thenReturn("user");
        when(content.parts()).thenReturn(Optional.of(ImmutableList.of(textPart)));
        FunctionDeclaration funcDeclaration = mock(FunctionDeclaration.class);
        GenerateContentConfig.ToolsConfig toolsConfig = mock(GenerateContentConfig.ToolsConfig.class);
        when(toolsConfig.functionDeclarations()).thenReturn(Optional.of(ImmutableList.of(funcDeclaration)));
        GenerateContentConfig config = mock(GenerateContentConfig.class);
        when(config.tools()).thenReturn(Optional.of(ImmutableList.of(toolsConfig)));
        Part sys = mock(Part.class);
        when(sys.text()).thenReturn(Optional.of("system txt"));
        Content sysContent = mock(Content.class);
        when(sysContent.parts()).thenReturn(Optional.of(ImmutableList.of(sys)));
        when(config.systemInstruction()).thenReturn(Optional.of(sysContent));
        Map<String, BaseTool> toolsMap = ImmutableMap.of("foo", mock(BaseTool.class));
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.model()).thenReturn(Optional.of("special-model"));
        when(llmRequest.contents()).thenReturn(ImmutableList.of(content));
        when(llmRequest.config()).thenReturn(Optional.of(config));
        when(llmRequest.tools()).thenReturn(new ArrayList<>(toolsMap.values()));
        Message anthropicMessage = mock(Message.class);
        when(((AnthropicClient.Messages)anthropicMessages).create(any())).thenReturn(anthropicMessage);
        LlmResponse resp = mock(LlmResponse.class);
        doReturn(resp).when(localClaude).convertAnthropicResponseToLlmResponse(anthropicMessage);
        Flowable<LlmResponse> result = localClaude.generateContent(llmRequest, false);
        verify((AnthropicClient.Messages)anthropicMessages).create(paramsCaptor.capture());
        MessageCreateParams params = paramsCaptor.getValue();
        assertEquals("special-model", (String)params.model());
        assertEquals("system txt", (String)params.system());
        assertEquals(maxTokens, (int)params.maxTokens());
        assertFalse(((List<?>)params.messages()).isEmpty());
        assertFalse(((List<?>)params.tools()).isEmpty());
        assertNotNull(params.toolChoice());
        result.test().assertValue(resp);
    }
