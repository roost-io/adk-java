        }
        LlmRequest llmRequest = baseLlmRequestWithContents(contents);
        Message message = mock(Message.class);
        when(((AnthropicClient) anthropicMessages).create(any())).thenReturn(message);
        doReturn(responseFromMessage(message)).when(claude).convertAnthropicResponseToLlmResponse(message);
        claude.generateContent(llmRequest, false).blockingFirst();
        ArgumentCaptor<MessageCreateParams> paramsCaptor = ArgumentCaptor.forClass(MessageCreateParams.class);
        verify(((AnthropicClient)anthropicMessages)).create(paramsCaptor.capture());
        MessageCreateParams actualParams = paramsCaptor.getValue();
        assertEquals(3, ((List) actualParams.messages()).size());
    }
