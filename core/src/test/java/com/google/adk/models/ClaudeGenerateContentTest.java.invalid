    @Test
    @Tag("valid")
    public void testRoleMappingAssistantAndUser() {
        // Arrange: one assistant, one user
        com.google.genai.types.Part ap = mockTextPart("assistant text");
        com.google.genai.types.Part up = mockTextPart("user text");
        com.google.genai.types.Content assistantContent = mockContent("assistant", com.google.common.collect.ImmutableList.of(ap));
        com.google.genai.types.Content userContent = mockContent("user", com.google.common.collect.ImmutableList.of(up));
        LlmRequest llmRequest = mockTextOnlyLlmRequest(
                com.google.common.collect.ImmutableList.of(assistantContent, userContent),
                Optional.of("m"),
                Optional.empty(),
                com.google.common.collect.ImmutableMap.of()
        );
        Message message = mockAnthropicTextMessage("ok");
        when(anthropicClient.messages().create(any(MessageCreateParams.class))).thenReturn(message);
        Claude claude = newClaude();
        // Act
        Flowable<LlmResponse> flow = claude.generateContent(llmRequest, false);
        // Assert params roles
        verify(anthropicClient.messages(), times(1)).create(messageCreateParamsCaptor.capture());
        MessageCreateParams captured = messageCreateParamsCaptor.getValue();
        assertNotNull(captured, "MessageCreateParams should not be null");
        List<MessageParam> msgs = captured.messages();
        assertNotNull(msgs, "messages should not be null");
        assertEquals(2, (int) msgs.size(), "Should map both contents to messages");
        assertEquals(Role.ASSISTANT, msgs.get(0).role(), "Assistant role should map to Role.ASSISTANT");
        assertEquals(Role.USER, msgs.get(1).role(), "User role should map to Role.USER");
        // Assert flow
        TestSubscriber<LlmResponse> ts = flow.test();
        ts.assertValueCount(1);
        ts.assertComplete();
        ts.assertNoErrors();
    }
