    Part p1 = mockTextPart(" alpha ");
    Part p2 = mockTextPart("beta");
    Part p3 = mockTextPart(" gamma ");
    Content system = mockContent(Optional.of("system"), Optional.of(List.of(p1, p2, p3)));
    GenerateContentConfig config = mockConfigWithSystemInstruction(Optional.of(system));
    LlmRequest req = mockRequest(Optional.empty(), List.of(), Optional.of(config), Map.of());
    new Claude("m", deep).generateContent(req, false).toList().blockingGet();
    assertEquals(" alpha \nbeta\n gamma ", (String) captor.getValue().system());
  }
  @Test
  @Tag("valid")
  public void toolChoiceDisablesParallelToolUse() {
    Message response = mockAnthropicMessageWithText("ok");
    AnthropicClient deep = Mockito.mock(AnthropicClient.class, Mockito.RETURNS_DEEP_STUBS);
    ArgumentCaptor<MessageCreateParams> captor = ArgumentCaptor.forClass(MessageCreateParams.class);
    when(deep.messages().create(captor.capture())).thenReturn(response);
    FunctionDeclaration fd = mockFunctionDeclaration("fn", Map.of());
    com.google.genai.types.Tool t = mockConfigToolWithFunctionDecls(List.of(fd));
    GenerateContentConfig config = mockConfigWithTools(List.of(t));
    LlmRequest req = mockRequest(Optional.empty(), List.of(), Optional.of(config), Map.of("t1", Mockito.mock(Object.class)));
    new Claude("m", deep).generateContent(req, false).toList().blockingGet();
    ToolChoice choice = captor.getValue().toolChoice();
    assertNotNull((Object) choice);
    // If accessible, unwrap and assert disableParallelToolUse == true
    // We cannot guarantee API; minimal validation performed
  }
  @Test
  @Tag("valid")
  public void mapsMixedResponseBlocksToParts() {
    ContentBlock textBlock = Mockito.mock(ContentBlock.class);
    when(textBlock.type()).thenReturn("text");
    ContentBlock toolUseBlock = Mockito.mock(ContentBlock.class);
    when(toolUseBlock.type()).thenReturn("tool_use");
    Message response = mockAnthropicMessageWithBlocks(List.of(textBlock, toolUseBlock));
    AnthropicClient deep = mockDeepAnthropicClientReturning(response);
    Claude subject = new Claude("m", deep);
    LlmRequest req = mockRequest(Optional.empty(), List.of(), Optional.empty(), Map.of());
    LlmResponse out = subject.generateContent(req, false).blockingFirst();
    assertNotNull((Object) out);
  }
  @Test
  @Tag("invalid")
  public void throwsOnUnsupportedResponseContentBlock() {
    ContentBlock unsupported = Mockito.mock(ContentBlock.class);
    when(unsupported.type()).thenReturn("unknown_type");
    Message response = mockAnthropicMessageWithBlocks(List.of(unsupported));
    AnthropicClient deep = mockDeepAnthropicClientReturning(response);
    Claude subject = new Claude("m", deep);
    LlmRequest req = mockRequest(Optional.empty(), List.of(), Optional.empty(), Map.of());
    assertThrows(UnsupportedOperationException.class, () -> subject.generateContent(req, false).toList().blockingGet());
  }
}