        LlmResponse resp = mock(LlmResponse.class);
        doReturn(resp).when(claude).convertAnthropicResponseToLlmResponse(anthropicMessage);
        Flowable<LlmResponse> flowTrue = claude.generateContent(llmRequest, true);
