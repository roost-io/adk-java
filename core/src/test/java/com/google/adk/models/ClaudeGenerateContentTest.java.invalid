    @Test
    @Tag("valid")
    public void testGenerateContentMapsModelRolesCorrectly() {
        Part part1 = mock(Part.class);
        when(part1.text()).thenReturn(Optional.of("model reply"));
        Content contentModel = mock(Content.class);
        when(contentModel.role()).thenReturn("model");
        when(contentModel.parts()).thenReturn(Optional.of(ImmutableList.of(part1)));
        Part part2 = mock(Part.class);
        when(part2.text()).thenReturn(Optional.of("assistant reply"));
        Content contentAssistant = mock(Content.class);
        when(contentAssistant.role()).thenReturn("assistant");
        when(contentAssistant.parts()).thenReturn(Optional.of(ImmutableList.of(part2)));
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.model()).thenReturn(Optional.of("test-model"));
        when(llmRequest.contents()).thenReturn(ImmutableList.of(contentModel, contentAssistant));
        when(llmRequest.config()).thenReturn(Optional.empty());
        when(llmRequest.tools()).thenReturn(Collections.emptyList());
        doAnswer(invocation -> {
            MessageCreateParams params = invocation.getArgument(0);
            for (MessageParam m : params.messages()) {
                assertEquals(Role.ASSISTANT, (Role)m.role());
            }
            return mock(Message.class);
        }).when(((AnthropicClient.Messages)anthropicMessages)).create(any());
        LlmResponse resp = mock(LlmResponse.class);
        doReturn(resp).when(claude).convertAnthropicResponseToLlmResponse(any());
        claude.generateContent(llmRequest, false).test();
    }
