    @Test
    @Tag("invalid")
    public void testPropagatesAnthropicExceptions() {
        // Arrange
        com.google.genai.types.Part p = mockTextPart("boom");
        com.google.genai.types.Content content = mockContent("user", com.google.common.collect.ImmutableList.of(p));
        LlmRequest llmRequest = mockTextOnlyLlmRequest(
                com.google.common.collect.ImmutableList.of(content),
                Optional.empty(),
                Optional.empty(),
                com.google.common.collect.ImmutableMap.of()
        );
        when(anthropicClient.messages().create(any(MessageCreateParams.class))).thenThrow(new RuntimeException("service down"));
        Claude claude = newClaude();
        // Act + Assert
        RuntimeException ex = assertThrows(RuntimeException.class, () -> claude.generateContent(llmRequest, false));
        assertEquals("service down", ex.getMessage(), "Exception message should propagate from client");
    }
