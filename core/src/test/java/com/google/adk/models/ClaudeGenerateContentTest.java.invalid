    @Test
    @Tag("valid")
    void testGenerateContentSystemInstructionSkipsNonTextParts() {
        Part textPart1 = mock(Part.class);
        when(textPart1.text()).thenReturn(Optional.of("AAA"));
        Part nonTextPart = mock(Part.class);
        when(nonTextPart.text()).thenReturn(Optional.empty());
        Part textPart2 = mock(Part.class);
        when(textPart2.text()).thenReturn(Optional.of("BBB"));
        Content systemInstruction = mock(Content.class);
        when(systemInstruction.parts()).thenReturn(Optional.of(ImmutableList.of(textPart1, nonTextPart, textPart2)));
        GenerateContentConfig config = mock(GenerateContentConfig.class);
        when(config.systemInstruction()).thenReturn(Optional.of(systemInstruction));
        when(config.tools()).thenReturn(Optional.empty());
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.contents()).thenReturn(ImmutableList.of());
        when(llmRequest.config()).thenReturn(Optional.of(config));
        when(llmRequest.tools()).thenReturn(ImmutableMap.of());
        when(llmRequest.model()).thenReturn(Optional.empty());
        Message message = mock(Message.class);
        stubMessagesCreateReturn(message);
        Claude spyClaude = spy(claude);
        doReturn(mock(LlmResponse.class)).when(spyClaude).convertAnthropicResponseToLlmResponse(message);
        AnthropicClient.Messages messagesClient = anthropicClient.messages();
        when(messagesClient.create(any())).thenReturn(message);
        doReturn(messagesClient).when(spyClaude.anthropicClient).messages();
        spyClaude.generateContent(llmRequest, false).toList().blockingGet();
        verify(messagesClient).create(messageCreateParamsCaptor.capture());
        MessageCreateParams params = (MessageCreateParams)messageCreateParamsCaptor.getValue();
        assertEquals("AAA\nBBB", params.system());
    }
    @Test
    @Tag("valid")
    void testGenerateContentSetsMaxTokensFromField() {
        int setMax = 3214;
        Claude c = new Claude("custom-model", anthropicClient, setMax);
        Claude spyClaude = spy(c);
        when(anthropicClient.messages()).thenReturn(
                new AnthropicClient.Messages() {
                    @Override public Message create(MessageCreateParams params) { return null; }
                }
        );
        LlmRequest llmRequest = mock(LlmRequest.class);
