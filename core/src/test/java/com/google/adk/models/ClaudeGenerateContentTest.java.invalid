    @Test
    @Tag("valid")
    void testGenerateContentWithMinimumValidLlmRequest() {
        String promptText = "Hello Anthropic!";
        Part part = mock(Part.class);
        when(part.text()).thenReturn(Optional.of(promptText));
        Content content = mock(Content.class);
        when(content.role()).thenReturn("user");
        when(content.parts()).thenReturn(Optional.of(ImmutableList.of(part)));
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.contents()).thenReturn(ImmutableList.of(content));
        when(llmRequest.config()).thenReturn(Optional.empty());
        when(llmRequest.tools()).thenReturn(ImmutableMap.of());
        when(llmRequest.model()).thenReturn(Optional.of("claude-3"));
        Message message = mock(Message.class);
        // Stub messages create call to return this mock message
        stubMessagesCreateReturn(message);
        MessageParam expectedMessageParam = mock(MessageParam.class);
        Claude spyClaude = spy(claude);
        doReturn(expectedMessageParam).when(spyClaude).contentToAnthropicMessageParam(any());
        LlmResponse expectedLlmResponse = mock(LlmResponse.class);
        doReturn(expectedLlmResponse).when(spyClaude).convertAnthropicResponseToLlmResponse(message);
        // re-wire messages().create for our spy
        AnthropicClient.Messages messagesClient = anthropicClient.messages();
        when(messagesClient.create(any())).thenReturn(message);
        doReturn(messagesClient).when(spyClaude.anthropicClient).messages();
        // Act
        Flowable<LlmResponse> responseFlowable = spyClaude.generateContent(llmRequest, false);
        List<LlmResponse> emitted = responseFlowable.toList().blockingGet();
        assertEquals(1, emitted.size());
        assertSame(expectedLlmResponse, emitted.get(0));
        verify(messagesClient).create(messageCreateParamsCaptor.capture());
        MessageCreateParams mcp = (MessageCreateParams)messageCreateParamsCaptor.getValue();
        assertEquals("claude-3", mcp.model());
        assertEquals("", mcp.system());
        assertEquals(4711, mcp.maxTokens());
        assertEquals(List.of(expectedMessageParam), mcp.messages());
        assertNull(mcp.toolChoice());
        assertNull(mcp.tools());
    }
    @Test
    @Tag("valid")
    void testGenerateContentWithMultipleContentParts() {
        Part part1 = mock(Part.class);
        when(part1.text()).thenReturn(Optional.of("First message"));
        Part part2 = mock(Part.class);
        when(part2.text()).thenReturn(Optional.of("Second message"));
        Content content1 = mock(Content.class);
        when(content1.role()).thenReturn("user");
        when(content1.parts()).thenReturn(Optional.of(ImmutableList.of(part1)));
        Content content2 = mock(Content.class);
        when(content2.role()).thenReturn("user");
        when(content2.parts()).thenReturn(Optional.of(ImmutableList.of(part2)));
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.contents()).thenReturn(ImmutableList.of(content1, content2));
        when(llmRequest.config()).thenReturn(Optional.empty());
        when(llmRequest.tools()).thenReturn(ImmutableMap.of());
        when(llmRequest.model()).thenReturn(Optional.empty());
        MessageParam messageParam1 = mock(MessageParam.class);
        MessageParam messageParam2 = mock(MessageParam.class);
        Message message = mock(Message.class);
        stubMessagesCreateReturn(message);
        Claude spyClaude = spy(claude);
        doReturn(messageParam1).when(spyClaude).contentToAnthropicMessageParam(content1);
        doReturn(messageParam2).when(spyClaude).contentToAnthropicMessageParam(content2);
        LlmResponse expectedResponse = mock(LlmResponse.class);
        doReturn(expectedResponse).when(spyClaude).convertAnthropicResponseToLlmResponse(message);
        // set client for spy
        AnthropicClient.Messages messagesClient = anthropicClient.messages();
        when(messagesClient.create(any())).thenReturn(message);
        doReturn(messagesClient).when(spyClaude.anthropicClient).messages();
        Flowable<LlmResponse> flowable = spyClaude.generateContent(llmRequest, false);
        List<LlmResponse> out = flowable.toList().blockingGet();
        assertEquals(1, out.size());
        assertSame(expectedResponse, out.get(0));
        verify(messagesClient).create(messageCreateParamsCaptor.capture());
        MessageCreateParams params = (MessageCreateParams)messageCreateParamsCaptor.getValue();
        assertEquals(2, params.messages().size());
