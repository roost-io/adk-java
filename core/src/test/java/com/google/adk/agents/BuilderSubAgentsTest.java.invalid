package com.google.adk.agents;
import com.google.adk.events.Event;
import com.google.common.collect.ImmutableList;
import com.google.errorprone.annotations.CanIgnoreReturnValue;
import io.reactivex.rxjava3.core.Flowable;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import java.lang.annotation.Annotation;
import java.lang.reflect.Method;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

class BuilderSubAgentsTest {
    // Helper stub for BaseAgent (since it's abstract)
    static class TestBaseAgent extends BaseAgent {
        TestBaseAgent(String name) {
            super(name, "desc", Collections.emptyList(), Optional.empty(), Optional.empty());
        }
        @Override
        protected Flowable<Event> runAsyncImpl(InvocationContext invocationContext) {
            return Flowable.empty();
        }
        @Override
        protected Flowable<Event> runLiveImpl(InvocationContext invocationContext) {
            return Flowable.empty();
        }
    }
    // Helper subclass for polymorphism test
    static class SubTestBaseAgent extends TestBaseAgent {
        SubTestBaseAgent(String name) {
            super(name);
        }
    }
    // Helper to access the nested Builder class
    private LoopAgent.Builder newBuilder() {
        return LoopAgent.builder();
    }
    @Test
    @Tag("valid")
    public void testSubAgentsWithNonEmptyList() {
        List<BaseAgent> agentList = new ArrayList<>();
        agentList.add(new TestBaseAgent("Agent1"));
        LoopAgent.Builder builder = newBuilder();
        LoopAgent.Builder returned = builder.subAgents(agentList);
        // Reflection to access private field for test validation
        try {
            java.lang.reflect.Field subAgentsField = builder.getClass().getDeclaredField("subAgents");
            subAgentsField.setAccessible(true);
            Object value = subAgentsField.get(builder);
            assertSame((Object) agentList, value, "subAgents field should reference the provided list");
        } catch (Exception e) {
            fail("Reflection failed: " + e.getMessage());
        }
        assertSame((Object) builder, returned, "Returned builder should be the same instance for chaining");
    }
    @Test
    @Tag("boundary")
    public void testSubAgentsWithEmptyList() {
        List<BaseAgent> emptyList = new ArrayList<>();
        LoopAgent.Builder builder = newBuilder();
        LoopAgent.Builder returned = builder.subAgents(emptyList);
        try {
            java.lang.reflect.Field subAgentsField = builder.getClass().getDeclaredField("subAgents");
            subAgentsField.setAccessible(true);
            Object value = subAgentsField.get(builder);
            assertSame((Object) emptyList, value, "subAgents field should reference the empty list");
        } catch (Exception e) {
            fail("Reflection failed: " + e.getMessage());
        }
        assertSame((Object) builder, returned, "Returned builder should be the same instance for chaining");
    }
    @Test
    @Tag("boundary")
    public void testSubAgentsWithNull() {
        LoopAgent.Builder builder = newBuilder();
        LoopAgent.Builder returned = builder.subAgents(null);
        try {
            java.lang.reflect.Field subAgentsField = builder.getClass().getDeclaredField("subAgents");
            subAgentsField.setAccessible(true);
            Object value = subAgentsField.get(builder);
            assertNull(value, "subAgents field should be null when set with null");
        } catch (Exception e) {
            fail("Reflection failed: " + e.getMessage());
        }
        assertSame((Object) builder, returned, "Returned builder should be the same instance for chaining");
    }
    @Test
    @Tag("valid")
    public void testSubAgentsOverwritePreviousValue() {
        List<BaseAgent> firstList = new ArrayList<>();
        firstList.add(new TestBaseAgent("Agent1"));
        List<BaseAgent> secondList = new ArrayList<>();
        secondList.add(new TestBaseAgent("Agent2"));
        LoopAgent.Builder builder = newBuilder();
        builder.subAgents(firstList);
        builder.subAgents(secondList);
        try {
            java.lang.reflect.Field subAgentsField = builder.getClass().getDeclaredField("subAgents");
            subAgentsField.setAccessible(true);
            Object value = subAgentsField.get(builder);
            assertSame((Object) secondList, value, "subAgents field should reference the most recently provided list");
        } catch (Exception e) {
            fail("Reflection failed: " + e.getMessage());
        }
    }
    @Test
    @Tag("valid")
    public void testSubAgentsSupportsMethodChaining() {
        List<BaseAgent> agentList = new ArrayList<>();
        agentList.add(new TestBaseAgent("Agent1"));
        LoopAgent.Builder builder = newBuilder();
        LoopAgent.Builder returned = builder.subAgents(agentList).name("TestName").description("TestDesc");
        assertSame((Object) builder, returned, "Returned builder should be the same instance for chaining");
        try {
            java.lang.reflect.Field nameField = builder.getClass().getDeclaredField("name");
            nameField.setAccessible(true);
            Object nameValue = nameField.get(builder);
            assertEquals("TestName", (String) nameValue, "Name field should be set correctly");
            java.lang.reflect.Field descField = builder.getClass().getDeclaredField("description");
            descField.setAccessible(true);
            Object descValue = descField.get(builder);
            assertEquals("TestDesc", (String) descValue, "Description field should be set correctly");
        } catch (Exception e) {
            fail("Reflection failed: " + e.getMessage());
        }
    }
    @Test
    @Tag("boundary")
    public void testSubAgentsWithListContainingNulls() {
        List<BaseAgent> agentList = new ArrayList<>();
        agentList.add(new TestBaseAgent("Agent1"));
        agentList.add(null);
        agentList.add(new TestBaseAgent("Agent2"));
        LoopAgent.Builder builder = newBuilder();
        builder.subAgents(agentList);
        try {
            java.lang.reflect.Field subAgentsField = builder.getClass().getDeclaredField("subAgents");
            subAgentsField.setAccessible(true);
            Object value = subAgentsField.get(builder);
            assertSame((Object) agentList, value, "subAgents field should reference the list with nulls");
            assertTrue(((List<?>) value).contains(null), "subAgents list should contain null elements");
        } catch (Exception e) {
            fail("Reflection failed: " + e.getMessage());
        }
    }
    @Test
    @Tag("valid")
    public void testSubAgentsDoesNotAffectOtherFields() {
        LoopAgent.Builder builder = newBuilder();
        builder.name("AgentName").description("AgentDesc").maxIterations(5);
        List<BaseAgent> agentList = new ArrayList<>();
        agentList.add(new TestBaseAgent("Agent1"));
        builder.subAgents(agentList);
        try {
            java.lang.reflect.Field nameField = builder.getClass().getDeclaredField("name");
            nameField.setAccessible(true);
            Object nameValue = nameField.get(builder);
            assertEquals("AgentName", (String) nameValue, "Name field should remain unchanged");
            java.lang.reflect.Field descField = builder.getClass().getDeclaredField("description");
            descField.setAccessible(true);
            Object descValue = descField.get(builder);
            assertEquals("AgentDesc", (String) descValue, "Description field should remain unchanged");
            java.lang.reflect.Field maxIterField = builder.getClass().getDeclaredField("maxIterations");
            maxIterField.setAccessible(true);
            Object maxIterValue = maxIterField.get(builder);
            assertEquals(Optional.of(5), (Optional<?>) maxIterValue, "maxIterations field should remain unchanged");
        } catch (Exception e) {
            fail("Reflection failed: " + e.getMessage());
        }
    }
    @Test
    @Tag("integration")
    public void testSubAgentsFieldUsedInBuild() {
        List<BaseAgent> agentList = new ArrayList<>();
        agentList.add(new TestBaseAgent("Agent1"));
        LoopAgent.Builder builder = newBuilder();
        builder.subAgents(agentList);
        LoopAgent loopAgent = builder.build();
        List<? extends BaseAgent> actualSubAgents = loopAgent.subAgents();
        assertSame((Object) agentList, (Object) actualSubAgents, "LoopAgent's subAgents should match the list provided to the builder");
    }
    @Test
    @Tag("valid")
    public void testSubAgentsWithSubclassList() {
        List<SubTestBaseAgent> subclassList = new ArrayList<>();
        subclassList.add(new SubTestBaseAgent("SubAgent1"));
        LoopAgent.Builder builder = newBuilder();
        builder.subAgents(subclassList);
        try {
            java.lang.reflect.Field subAgentsField = builder.getClass().getDeclaredField("subAgents");
            subAgentsField.setAccessible(true);
            Object value = subAgentsField.get(builder);
            assertSame((Object) subclassList, value, "subAgents field should reference the provided list of subclass instances");
        } catch (Exception e) {
            fail("Reflection failed: " + e.getMessage());
        }
    }
    @Test
    @Tag("valid")
    public void testSubAgentsHasCanIgnoreReturnValueAnnotation() throws Exception {
        Method method = LoopAgent.Builder.class.getDeclaredMethod("subAgents", List.class);
        Annotation annotation = method.getAnnotation(CanIgnoreReturnValue.class);
        assertNotNull(annotation, "subAgents method should be annotated with @CanIgnoreReturnValue");
    }
}