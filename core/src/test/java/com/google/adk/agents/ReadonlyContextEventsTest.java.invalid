class ReadonlyContextEventsTest {
    private InvocationContext mockInvocationContext;
    private ReadonlyContext readonlyContext;
    private List<Event> mutableEventsList;
    @BeforeEach
    void setUp() {
        mockInvocationContext = mock(InvocationContext.class);
        mutableEventsList = new ArrayList<>();
        Event event1 = mock(Event.class);
        Event event2 = mock(Event.class);
        mutableEventsList.add(event1);
        mutableEventsList.add(event2);
        // Since Session class is not available, we mock the invocationContext.session().events() directly
        // by stubbing invocationContext.session() to return an object with an events() method.
        // We'll use a simple stub for session() that returns an object with the required events() method.
        Object mockSession = new Object() {
            public List<Event> events() {
                return mutableEventsList;
            }
        };
        // Use Mockito to stub the session() method to return our mockSession object
        when(mockInvocationContext.session()).thenReturn((Object) mockSession);
        // Now, we need to ensure that ReadonlyContext.events() calls invocationContext.session().events()
        // Since the real code expects session() to return an object with an events() method, and we can't use Session,
        // we must ensure that the ReadonlyContext implementation uses reflection or similar to call events().
        // If that's not the case, the business logic needs to be updated to not require Session type directly.
        readonlyContext = new ReadonlyContext(mockInvocationContext);
    }
    @Test
    @Tag("valid")
    public void testReturnsUnmodifiableListOfEventsWhenEventsViewIsNull() {
        // Arrange
        // eventsView is null by default on new ReadonlyContext
        // Act
        List<Event> result = readonlyContext.events();
        // Assert
        assertEquals((List<Event>) mutableEventsList, result, "Returned list should contain the same elements as session().events()");
        assertThrows(UnsupportedOperationException.class, () -> result.add(mock(Event.class)), "Returned list should be unmodifiable");
        // NOTE: If this test fails due to ClassCastException or NoSuchMethodException, the business logic should be updated
        // to not require a concrete Session type, or Session should be made available for testing.
    }
}