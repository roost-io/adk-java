        assertEquals(1, beforeAgentCallbacks.size(), "beforeAgentCallback should contain only the most recent callback");
        assertSame((Object)secondCallback, (Object)beforeAgentCallbacks.get(0), "beforeAgentCallback should contain the second callback");
    }
