        Callbacks.BeforeAgentCallback firstCallback = mock(Callbacks.BeforeAgentCallback.class);
        Callbacks.BeforeAgentCallback secondCallback = mock(Callbacks.BeforeAgentCallback.class);
        builder.beforeAgentCallback(firstCallback);
        builder.beforeAgentCallback(secondCallback);
