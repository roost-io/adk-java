        ImmutableList<Callbacks.BeforeAgentCallback> beforeAgentCallbacks = getBeforeAgentCallbackField(builder);
        assertSame((Object)builder, (Object)returnedBuilder, "Builder should return itself for chaining");
        assertNotNull((Object)beforeAgentCallbacks, "beforeAgentCallback field should not be null");
        assertEquals(1, beforeAgentCallbacks.size(), "beforeAgentCallback should contain exactly one element");
        assertSame((Object)callback, (Object)beforeAgentCallbacks.get(0), "beforeAgentCallback should contain the provided callback");
    }
