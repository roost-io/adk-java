class ReadonlyContextUserIdTest {
    @Test
    @Tag("valid")
    @DisplayName("userId() returns valid user ID from session")
    public void testUserIdReturnsValidUserId() {
        // Session is a class in the business logic, so mock it using its fully qualified name if needed
        Session mockSession = Mockito.mock(Session.class);
        Mockito.when(mockSession.userId()).thenReturn("user-123");
        InvocationContext mockInvocationContext = Mockito.mock(InvocationContext.class);
        Mockito.when(mockInvocationContext.session()).thenReturn(mockSession);
        ReadonlyContext context = new ReadonlyContext(mockInvocationContext);
        String result = (String) context.userId();
        assertEquals("user-123", result, "userId() should return the user ID from session");
    }
    @Test
    @Tag("boundary")
    @DisplayName("userId() returns null when session.userId() is null")
    public void testUserIdReturnsNullWhenSessionUserIdIsNull() {
        Session mockSession = Mockito.mock(Session.class);
        Mockito.when(mockSession.userId()).thenReturn(null);
        InvocationContext mockInvocationContext = Mockito.mock(InvocationContext.class);
        Mockito.when(mockInvocationContext.session()).thenReturn(mockSession);
        ReadonlyContext context = new ReadonlyContext(mockInvocationContext);
        String result = (String) context.userId();
        assertNull(result, "userId() should return null when session.userId() is null");
    }
    @Test
    @Tag("invalid")
    @DisplayName("userId() propagates exception from session.userId()")
    public void testUserIdPropagatesExceptionFromSession() {
        Session mockSession = Mockito.mock(Session.class);
        Mockito.when(mockSession.userId()).thenThrow(new RuntimeException("Session error"));
        InvocationContext mockInvocationContext = Mockito.mock(InvocationContext.class);
        Mockito.when(mockInvocationContext.session()).thenReturn(mockSession);
        ReadonlyContext context = new ReadonlyContext(mockInvocationContext);
        assertThrows(RuntimeException.class, new Executable() {
            @Override
            public void execute() {
                context.userId();
            }
        }, "userId() should propagate exception thrown by session.userId()");
    }
