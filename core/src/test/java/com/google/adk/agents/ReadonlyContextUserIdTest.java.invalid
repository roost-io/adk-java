        String firstCall = (String) context.userId();
        String secondCall = (String) context.userId();
        String thirdCall = (String) context.userId();
        assertEquals("user-456", firstCall, "First call should return the correct user ID");
        assertEquals("user-456", secondCall, "Second call should return the same user ID");
        assertEquals("user-456", thirdCall, "Third call should return the same user ID");
