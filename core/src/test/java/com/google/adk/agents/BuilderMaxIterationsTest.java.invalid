public class BuilderMaxIterationsTest {
    @Test
    @Tag("valid")
    public void testSetPositiveMaxIterations() {
        LoopAgent.Builder builder = new LoopAgent.Builder();
        builder.maxIterations(5);
        // maxIterations is private, so we must use the public API if available.
        // If there is no getter for maxIterations, the business logic should provide one for testing.
        // Otherwise, this test cannot verify the value and needs a getter or a build() method to check.
        LoopAgent agent = builder.build();
        assertTrue(((Optional<Integer>) agent.maxIterations()).isPresent(), "maxIterations should be present");
        assertEquals((Integer)5, ((Optional<Integer>) agent.maxIterations()).get(), "maxIterations should be 5");
    }
