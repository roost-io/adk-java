        assertTrue(((Optional<Integer>) agent.maxIterations()).isPresent(), "maxIterations should be present");
        assertEquals((Integer)10, ((Optional<Integer>) agent.maxIterations()).get(), "maxIterations should be 10");
    }
    @Test
