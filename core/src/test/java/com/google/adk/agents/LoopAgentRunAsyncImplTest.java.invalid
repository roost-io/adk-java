    @Test
    @Tag("valid")
    public void testSingleSubAgentNoEscalationRepeatsUntilMaxInt() {
        Event evt = createEventWithEscalate(Optional.of(false));
        BaseAgent subAgent = subAgentReturning(Flowable.just(evt));
        LoopAgent agent = LoopAgent.builder()
                .name("main")
                .description("desc")
                .subAgents(subAgent)
                .maxIterations(Optional.empty())
                .build();
        // Limit to 5 emissions to avoid very long test.
        TestSubscriber<Event> subscriber = agent.runAsyncImpl(createDummyContext()).take(5).test();
        subscriber.assertValueCount(5);
        subscriber.assertComplete();
        subscriber.assertValueAt(0, (e) -> e == (Event) evt);
    }
    @Test
    @Tag("valid")
    public void testMultipleSubAgentsNoEscalationRepeatsNIterations() {
        Event evt1 = createEventWithEscalate(Optional.of(false));
        Event evt2 = createEventWithEscalate(Optional.of(false));
        BaseAgent sub1 = subAgentReturning(Flowable.just(evt1));
        BaseAgent sub2 = subAgentReturning(Flowable.just(evt2));
        int N = 3;
        LoopAgent agent = LoopAgent.builder()
                .name("main")
                .description("desc")
                .subAgents(Arrays.asList(sub1, sub2))
                .maxIterations(N)
                .build();
        TestSubscriber<Event> subscriber = agent.runAsyncImpl(createDummyContext()).test();
        // (evt1,evt2), repeated N times
        subscriber.assertValueCount(2 * N);
        for (int i = 0; i < N; i++) {
            int idx = 2 * i;
            assertSame(evt1, (Event) subscriber.values().get(idx));
            assertSame(evt2, (Event) subscriber.values().get(idx + 1));
        }
        subscriber.assertComplete();
    }
    @Test
