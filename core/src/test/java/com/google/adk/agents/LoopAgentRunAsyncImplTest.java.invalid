    @Test
    public void worksWithBeforeAfterCallbacksAndSideEffects() {
        AtomicInteger beforeCtr = new AtomicInteger();
        AtomicInteger afterCtr = new AtomicInteger();
        TestAgent subAgent = new TestAgent(Flowable.just(newEvent()));
        LoopAgent agent = LoopAgent.builder()
            .name("loopAgent").description("desc")
            .subAgents(Arrays.asList(subAgent))
            .maxIterations(3)
            .beforeAgentCallback(Collections.singletonList((a, ctx) -> beforeCtr.incrementAndGet()))
            .afterAgentCallback(Collections.singletonList((a, ctx, evs) -> afterCtr.incrementAndGet()))
            .build();
        agent.runAsyncImpl(minimalContext()).subscribe();
        assertThat(beforeCtr.get()).isEqualTo(3);
        assertThat(afterCtr.get()).isEqualTo(3);
    }
