        TestSubscriber<Event> ts = new TestSubscriber<>();
        flow.subscribe(ts);
        ts.assertError(RuntimeException.class);
        Throwable err = ts.errors().get(0);
        assertThat(err).isNotNull();
        assertThat(err.getMessage()).contains("fail");
    }
