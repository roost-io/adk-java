        when(subAgent.runAsync(any())).thenReturn(Flowable.empty());
        loopAgent = new TestLoopAgent("name", "desc", ImmutableList.of(subAgent), Optional.of(1), ImmutableList.of(), ImmutableList.of());
        Flowable<Event> result = loopAgent.runAsyncImpl(invocationContext);
        List<Event> events = result.toList().blockingGet();
        assertTrue(((List<?>) events).isEmpty());
    }
    // Scenario 15: Max Iterations is Not Present (Optional.empty())
    @Test
    @Tag("boundary")
    public void testMaxIterationsNotPresentRepeatsIndefinitely() {
        BaseAgent subAgent = mock(BaseAgent.class);
        Event event = mockEventWithEscalate(Optional.of(false));
        when(subAgent.runAsync(any())).thenReturn(Flowable.just(event));
        loopAgent = new TestLoopAgent("name", "desc", ImmutableList.of(subAgent), Optional.empty(), ImmutableList.of(), ImmutableList.of());
        Flowable<Event> result = loopAgent.runAsyncImpl(invocationContext).take(5);
        List<Event> events = result.toList().blockingGet();
        assertEquals(5, (int) events.size());
        for (Event e : events) {
            assertSame(event, (Event) e);
        }
    }
    // Scenario 16: Sub-agent Emits Escalation Event Only in Last Iteration
    @Test
    @Tag("valid")
    public void testEscalationEventInLastIterationLoopStopsAfterEscalation() {
        BaseAgent subAgent = mock(BaseAgent.class);
        Event event1 = mockEventWithEscalate(Optional.of(false));
        Event event2 = mockEventWithEscalate(Optional.of(false));
        Event event3 = mockEventWithEscalate(Optional.of(true));
        AtomicInteger callCount = new AtomicInteger(0);
        when(subAgent.runAsync(any())).thenAnswer(invocation -> {
            int count = callCount.incrementAndGet();
            if (count == 1) return Flowable.just(event1);
            if (count == 2) return Flowable.just(event2);
            if (count == 3) return Flowable.just(event3);
            return Flowable.empty();
        });
        loopAgent = new TestLoopAgent("name", "desc", ImmutableList.of(subAgent), Optional.of(3), ImmutableList.of(), ImmutableList.of());
        Flowable<Event> result = loopAgent.runAsyncImpl(invocationContext);
        List<Event> events = result.toList().blockingGet();
        assertEquals(3, (int) events.size());
        assertSame(event1, (Event) events.get(0));
        assertSame(event2, (Event) events.get(1));
        assertSame(event3, (Event) events.get(2));
    }
    // Scenario 17: Sub-agent Emits Event with Escalate Action as Optional.empty()
    @Test
    @Tag("valid")
    public void testEscalateActionOptionalEmptyTreatedAsFalse() {
        BaseAgent subAgent = mock(BaseAgent.class);
        Event event = mockEventWithEscalate(Optional.empty());
        when(subAgent.runAsync(any())).thenReturn(Flowable.just(event));
        loopAgent = new TestLoopAgent("name", "desc", ImmutableList.of(subAgent), Optional.of(2), ImmutableList.of(), ImmutableList.of());
        Flowable<Event> result = loopAgent.runAsyncImpl(invocationContext);
        List<Event> events = result.toList().blockingGet();
        assertEquals(2, (int) events.size());
        assertSame(event, (Event) events.get(0));
        assertSame(event, (Event) events.get(1));
    }
    // Scenario 18: Sub-agent Emits Event with Escalate Action as False
    @Test
    @Tag("valid")
    public void testEscalateActionFalseDoesNotStopLoop() {
        BaseAgent subAgent = mock(BaseAgent.class);
        Event event = mockEventWithEscalate(Optional.of(false));
        when(subAgent.runAsync(any())).thenReturn(Flowable.just(event));
        loopAgent = new TestLoopAgent("name", "desc", ImmutableList.of(subAgent), Optional.of(2), ImmutableList.of(), ImmutableList.of());
        Flowable<Event> result = loopAgent.runAsyncImpl(invocationContext);
