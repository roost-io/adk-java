    public void testSubAgentEscalatesLoopStopsEarly() {
        Event nonEsc = createEventWithEscalate(Optional.of(false));
        Event esc = createEventWithEscalate(Optional.of(true));
        BaseAgent sub1 = subAgentReturning(Flowable.just(nonEsc));
        BaseAgent sub2 = subAgentReturning(Flowable.just(esc));
        LoopAgent agent = LoopAgent.builder()
                .name("main")
                .description("desc")
                .subAgents(Arrays.asList(sub1, sub2))
                .maxIterations(10)
                .build();
        TestSubscriber<Event> subscriber = agent.runAsyncImpl(createDummyContext()).test();
        // Should emit nonEsc, esc in order and halt after esc
        List<Event> values = subscriber.values();
        assertEquals(2, (int) values.size());
        assertSame(nonEsc, (Event) values.get(0));
        assertSame(esc, (Event) values.get(1));
        subscriber.assertComplete();
    }
