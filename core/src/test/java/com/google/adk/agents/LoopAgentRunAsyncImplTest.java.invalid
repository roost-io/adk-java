    @Test
    public void appliesBeforeAfterAgentCallbacksEveryIterationEvenOnErrorOrEscalate() {
        List<String> callbackInvocations = new ArrayList<>();
        TestAgent a1 = new TestAgent(Flowable.just(newEvent()));
        TestAgent a2 = new TestAgent(Flowable.error(new RuntimeException("fail")));
        LoopAgent agent = LoopAgent.builder()
            .name("loopAgent").description("desc")
            .subAgents(Arrays.asList(a1, a2))
            .beforeAgentCallback(Collections.singletonList((agent1, ctx) -> callbackInvocations.add("before:"+agent1.name())))
            .afterAgentCallback(Collections.singletonList((agent1, ctx, evs) -> callbackInvocations.add("after:"+agent1.name())))
            .build();
        TestSubscriber<Event> ts = new TestSubscriber<>();
        agent.runAsyncImpl(minimalContext()).subscribe(ts);
        assertThat(callbackInvocations).contains("before:"+a1.name());
        assertThat(callbackInvocations).contains("after:"+a1.name());
        assertThat(callbackInvocations).contains("before:"+a2.name());
        assertThat(callbackInvocations).contains("after:"+a2.name());
    }
