        assertSame(event, (Event) events.get(1));
    }
    // Scenario 19: Sub-agent Emits Event with Escalate Action as True
    @Test
    @Tag("valid")
    public void testEscalateActionTrueStopsLoopImmediately() {
        BaseAgent subAgent = mock(BaseAgent.class);
        Event event = mockEventWithEscalate(Optional.of(true));
        when(subAgent.runAsync(any())).thenReturn(Flowable.just(event));
        loopAgent = new TestLoopAgent("name", "desc", ImmutableList.of(subAgent), Optional.of(5), ImmutableList.of(), ImmutableList.of());
        Flowable<Event> result = loopAgent.runAsyncImpl(invocationContext);
        List<Event> events = result.toList().blockingGet();
        assertEquals(1, (int) events.size());
        assertSame(event, (Event) events.get(0));
    }
    // Scenario 20: Sub-agent Emits Events, Then runAsyncImpl is Disposed
    @Test
    @Tag("integration")
    public void testDisposingSubscriptionStopsEmission() {
        BaseAgent subAgent = mock(BaseAgent.class);
        Event event = mockEventWithEscalate(Optional.of(false));
        when(subAgent.runAsync(any())).thenReturn(Flowable.just(event));
        loopAgent = new TestLoopAgent("name", "desc", ImmutableList.of(subAgent), Optional.empty(), ImmutableList.of(), ImmutableList.of());
        TestSubscriber<Event> subscriber = new TestSubscriber<Event>() {
            int count = 0;
            @Override
            public void onNext(Event t) {
                super.onNext(t);
                count++;
                if (count == 2) {
                    this.dispose();
                }
            }
        };
        loopAgent.runAsyncImpl(invocationContext).subscribe(subscriber);
        subscriber.awaitDone(5, java.util.concurrent.TimeUnit.SECONDS);
        assertTrue(subscriber.values().size() <= 2);
    }
}