package com.google.adk.agents;
import org.junit.jupiter.api.*;
import com.google.adk.events.Event;
import com.google.common.collect.ImmutableList;
import com.google.errorprone.annotations.CanIgnoreReturnValue;
import io.reactivex.rxjava3.core.Flowable;
import java.util.List;
import java.util.Optional;

/** Unit tests for LoopAgent.runAsyncImpl. */
public final class LoopAgentRunAsyncImplTest {
  @Test
  public void runAsyncImpl_empty_subAgents_returns_empty() {
    LoopAgent loopAgent = LoopAgent.builder()
        .name("emptyAgent")
        .subAgents(ImmutableList.of())
        .build();
    InvocationContext ctx = createInvocationContext(loopAgent);
    List<Event> events = loopAgent.runAsyncImpl(ctx).toList().blockingGet();
    assertThat(events).isEmpty();
  }
  @Test
  public void runAsyncImpl_single_subAgent_single_iteration_returns_events() {
    Event event1 = createEvent("event1");
    Event event2 = createEvent("event2");
    TestBaseAgent subAgent = createSubAgent("subAgent", Flowable.just(event1, event2));
    LoopAgent loopAgent = LoopAgent.builder()
        .name("singleAgent")
        .subAgents(ImmutableList.of(subAgent))
        .maxIterations(1)
        .build();
    InvocationContext ctx = createInvocationContext(loopAgent);
    List<Event> events = loopAgent.runAsyncImpl(ctx).toList().blockingGet();
    assertThat(events).containsExactly(event1, event2).inOrder();
  }
  @Test
  public void runAsyncImpl_single_subAgent_multiple_iterations_returns_events() {
    Event event1 = createEvent("event1");
    TestBaseAgent subAgent = createSubAgent("subAgent", Flowable.just(event1));
    LoopAgent loopAgent = LoopAgent.builder()
        .name("multiAgent")
        .subAgents(ImmutableList.of(subAgent))
        .maxIterations(3)
        .build();
    InvocationContext ctx = createInvocationContext(loopAgent);
    List<Event> events = loopAgent.runAsyncImpl(ctx).toList().blockingGet();
    assertThat(events).containsExactly(event1, event1, event1).inOrder();
  }
  @Test
  public void runAsyncImpl_multiple_subAgents_single_iteration_returns_events_in_sequence() {
    Event eventA = createEvent("eventA");
    Event eventB = createEvent("eventB");
    TestBaseAgent subAgent1 = createSubAgent("agent1", Flowable.just(eventA));
    TestBaseAgent subAgent2 = createSubAgent("agent2", Flowable.just(eventB));
    LoopAgent loopAgent = LoopAgent.builder()
        .name("multiSubAgents")
        .subAgents(ImmutableList.of(subAgent1, subAgent2))
        .maxIterations(1)
        .build();
    InvocationContext ctx = createInvocationContext(loopAgent);
    List<Event> events = loopAgent.runAsyncImpl(ctx).toList().blockingGet();
    assertThat(events).containsExactly(eventA, eventB).inOrder();
  }
  @Test
  public void runAsyncImpl_terminates_on_escalate_action() {
    Event eventA = createEvent("eventA");
    Event eventEscalate = createEscalateEvent("escalateEvent");
    TestBaseAgent subAgent1 = createSubAgent("agent1", Flowable.just(eventA, eventEscalate));
    TestBaseAgent subAgent2 = createSubAgent("agent2", Flowable.just(eventA));
    LoopAgent loopAgent = LoopAgent.builder()
        .name("escalateAgent")
        .subAgents(ImmutableList.of(subAgent1, subAgent2))
        .maxIterations(5)
        .build();
    InvocationContext ctx = createInvocationContext(loopAgent);
    List<Event> events = loopAgent.runAsyncImpl(ctx).toList().blockingGet();
    // Should end after first escalate event, not run further agents or iterations
    assertThat(events).containsAtLeast(eventA, eventEscalate);
    assertThat(events).containsExactly(eventA, eventEscalate).inOrder();
  }
}