        subscriber.assertNoValues();
        subscriber.assertComplete();
    }
    // Scenario 3: Sub-agents List Contains One Agent, No Escalation, No Max Iterations
    @Test
    @Tag("valid")
    public void testSingleSubAgentNoEscalationNoMaxIterationsRepeatsIndefinitely() {
        BaseAgent subAgent = mock(BaseAgent.class);
        Event event = mockEventWithEscalate(Optional.of(false));
        when(subAgent.runAsync(any())).thenReturn(Flowable.just(event));
        loopAgent = new TestLoopAgent("name", "desc", ImmutableList.of(subAgent), Optional.empty(), ImmutableList.of(), ImmutableList.of());
        Flowable<Event> result = loopAgent.runAsyncImpl(invocationContext).take(3);
        List<Event> events = result.toList().blockingGet();
        assertEquals(3, (int) events.size());
        for (Event e : events) {
            assertSame(event, (Event) e);
        }
    }
    // Scenario 4: Sub-agents List Contains Multiple Agents, No Escalation, Max Iterations Set
    @Test
    @Tag("valid")
    public void testMultipleSubAgentsNoEscalationWithMaxIterationsRepeatsCorrectly() {
        BaseAgent subAgent1 = mock(BaseAgent.class);
        BaseAgent subAgent2 = mock(BaseAgent.class);
        Event event1 = mockEventWithEscalate(Optional.of(false));
        Event event2 = mockEventWithEscalate(Optional.of(false));
        when(subAgent1.runAsync(any())).thenReturn(Flowable.just(event1));
        when(subAgent2.runAsync(any())).thenReturn(Flowable.just(event2));
        int maxIterations = 2;
        loopAgent = new TestLoopAgent("name", "desc", ImmutableList.of(subAgent1, subAgent2), Optional.of(maxIterations), ImmutableList.of(), ImmutableList.of());
        Flowable<Event> result = loopAgent.runAsyncImpl(invocationContext);
        List<Event> events = result.toList().blockingGet();
        assertEquals(4, (int) events.size());
        assertSame(event1, (Event) events.get(0));
        assertSame(event2, (Event) events.get(1));
        assertSame(event1, (Event) events.get(2));
        assertSame(event2, (Event) events.get(3));
    }
