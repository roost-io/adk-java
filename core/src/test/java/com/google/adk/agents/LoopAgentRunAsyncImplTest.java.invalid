    @Test
    @Tag("valid")
    public void testEventEscalateActionIsEmptyNoEscalationOccurs() {
        Event evt = createEventWithEscalate(Optional.empty());
        BaseAgent sub = subAgentReturning(Flowable.just(evt));
        int N = 2; // TODO: Change for more iterations if desired
        LoopAgent agent = LoopAgent.builder()
                .name("main")
                .description("desc")
                .subAgents(sub)
                .maxIterations(N)
                .build();
        TestSubscriber<Event> subscriber = agent.runAsyncImpl(createDummyContext()).test();
        assertEquals(N, (int) subscriber.values().size());
        for (int i = 0; i < N; i++) {
            assertSame(evt, (Event) subscriber.values().get(i));
        }
        subscriber.assertComplete();
    }
    @Test
    @Tag("boundary")
    public void testMaxIterationsOmittedDefaultsToMaxInt() {
        Event evt = createEventWithEscalate(Optional.of(false));
        BaseAgent sub = subAgentReturning(Flowable.just(evt));
        LoopAgent agent = LoopAgent.builder()
                .name("main")
                .description("desc")
                .subAgents(sub)
                .build(); // maxIterations omitted
        // Sample first 5 (should repeat indefinitely)
        TestSubscriber<Event> subscriber = agent.runAsyncImpl(createDummyContext()).take(5).test();
        assertEquals(5, (int) subscriber.values().size());
        for (Event e : subscriber.values()) {
            assertSame(evt, (Event) e);
        }
        subscriber.assertComplete();
    }
    @Test
    @Tag("integration")
    public void testSubAgentEmitsMultipleEventsFlattenedPerIteration() {
        Event evtA = createEventWithEscalate(Optional.of(false));
        Event evtB = createEventWithEscalate(Optional.of(false));
        BaseAgent sub = subAgentReturning(Flowable.fromIterable(Arrays.asList(evtA, evtB)));
        int N = 3; // iterations
        LoopAgent agent = LoopAgent.builder()
                .name("main")
                .description("desc")
                .subAgents(sub)
                .maxIterations(N)
                .build();
        TestSubscriber<Event> subscriber = agent.runAsyncImpl(createDummyContext()).test();
        // (evtA, evtB) repeated N times
        assertEquals(N * 2, (int) subscriber.values().size());
        for (int i = 0; i < N; i++) {
            assertSame(evtA, (Event) subscriber.values().get(i * 2));
            assertSame(evtB, (Event) subscriber.values().get(i * 2 + 1));
        }
        subscriber.assertComplete();
    }
    @Test
    @Tag("valid")
    public void testAgentCallbacksSetDoesNotAffectRunAsyncImplBehavior() {
        Callbacks.BeforeAgentCallback beforeCb = mock(Callbacks.BeforeAgentCallback.class);
        Callbacks.AfterAgentCallback afterCb = mock(Callbacks.AfterAgentCallback.class);
        Event evt = createEventWithEscalate(Optional.of(false));
        BaseAgent sub = subAgentReturning(Flowable.just(evt));
        LoopAgent agent = LoopAgent.builder()
                .name("main")
                .description("desc")
                .subAgents(sub)
                .beforeAgentCallback(beforeCb)
                .afterAgentCallback(afterCb)
                .maxIterations(2)
                .build();
        // Output should not be affected by presence of callbacks
        TestSubscriber<Event> subscriber = agent.runAsyncImpl(createDummyContext()).test();
        assertEquals(2, (int) subscriber.values().size());
        subscriber.assertComplete();
    }
    @Test
    @Tag("integration")
    public void testSubAgentEmitDelayedEventsPropagateCorrectly() {
        Event evt = createEventWithEscalate(Optional.of(false));
        BaseAgent sub = subAgentReturning(Flowable.just(evt)); // .delay(Duration.ofMillis(10)) is not available in RxJava3's Flowable; would need to use .delay(long, TimeUnit)!
        // To achieve delay with RxJava3 Flowable:
        Flowable<Event> delayed = Flowable.just(evt).delay(10, java.util.concurrent.TimeUnit.MILLISECONDS);
        sub = subAgentReturning(delayed);
        LoopAgent agent = LoopAgent.builder()
                .name("main")
                .description("desc")
                .subAgents(sub)
                .maxIterations(2)
                .build();
        // This will block until all items are emitted
        TestSubscriber<Event> subscriber = agent.runAsyncImpl(createDummyContext()).test();
        subscriber.awaitDone(1, java.util.concurrent.TimeUnit.SECONDS);
        assertEquals(2, (int) subscriber.values().size());
        subscriber.assertComplete();
    }
    @Test
    @Tag("boundary")
    public void testSubAgentEmitsEmptyFlowableNoEventsEmitted() {
        BaseAgent sub = subAgentReturning(Flowable.empty());
        LoopAgent agent = LoopAgent.builder()
                .name("main")
                .description("desc")
                .subAgents(sub)
                .maxIterations(5)
                .build();
        TestSubscriber<Event> subscriber = agent.runAsyncImpl(createDummyContext()).test();
        subscriber.assertNoValues();
        subscriber.assertComplete();
    }
    @Test
    @Tag("valid")
    public void testSubAgentEmitsEventsThenThrowsError() {
        Event evtA = createEventWithEscalate(Optional.of(false));
        Event evtB = createEventWithEscalate(Optional.of(false));
        RuntimeException ex = new RuntimeException("after some events");
        Flowable<Event> f = Flowable.concat(Flowable.just(evtA, evtB), Flowable.<Event>error(ex));
        BaseAgent sub = subAgentReturning(f);
        LoopAgent agent = LoopAgent.builder()
                .name("main")
                .description("desc")
                .subAgents(sub)
                .maxIterations(1)
                .build();
        TestSubscriber<Event> subscriber = agent.runAsyncImpl(createDummyContext()).test();
        List<Event> values = subscriber.values();
        assertEquals(2, (int) values.size());
        assertSame(evtA, (Event) values.get(0));
        assertSame(evtB, (Event) values.get(1));
        subscriber.assertError(ex);
    }
    @Test
    @Tag("integration")
    public void testMultipleLoopAgentInstancesRunIndependently() {
        BaseAgent subA = subAgentReturning(Flowable.just(createEventWithEscalate(Optional.of(false))));
        BaseAgent subB = subAgentReturning(Flowable.just(createEventWithEscalate(Optional.of(true))));
        LoopAgent agent1 = LoopAgent.builder().name("a").description("desc").subAgents(subA).maxIterations(2).build();
        LoopAgent agent2 = LoopAgent.builder().name("b").description("desc").subAgents(subB).maxIterations(5).build();
        TestSubscriber<Event> subScriber1 = agent1.runAsyncImpl(createDummyContext()).test();
        TestSubscriber<Event> subScriber2 = agent2.runAsyncImpl(createDummyContext()).test();
        assertEquals(2, (int) subScriber1.values().size());
        assertEquals(1, (int) subScriber2.values().size());
        subScriber1.assertComplete();
        subScriber2.assertComplete();
    }
}