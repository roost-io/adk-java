    @Test
    public void returnsEmptyWhenSubAgentsNull() {
        LoopAgent agent = LoopAgent.builder()
            .name("loopAgent").description("desc").subAgents((List<BaseAgent>)null)
            .maxIterations(Optional.empty())
            .build();
        Flowable<Event> flow = agent.runAsyncImpl(minimalContext());
        TestSubscriber<Event> ts = new TestSubscriber<>();
        flow.subscribe(ts);
        ts.assertComplete();
        ts.assertNoValues();
    }
    @Test
    public void repeatsIntegerMaxValueIfMaxIterationsNotSet() {
        AtomicInteger callCount = new AtomicInteger();
        TestAgent subAgent = new TestAgent(Flowable.defer(() -> {
                callCount.incrementAndGet();
                return Flowable.just(newEvent());
            })
        );
        LoopAgent agent = LoopAgent.builder()
            .name("loopAgent").description("desc")
            .subAgents(Arrays.asList(subAgent)).build();
        Flowable<Event> flow = agent.runAsyncImpl(minimalContext());
        TestSubscriber<Event> ts = new TestSubscriber<>();
        flow.take(10).subscribe(ts);
        ts.assertValueCount(10);
        assertThat(callCount.get()).isAtLeast(10);
    }
