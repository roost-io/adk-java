    @Override
    protected Flowable<Event> runAsyncImpl(InvocationContext invocationContext) {
        // Not used in these tests
        return Flowable.empty();
    }
    @Override
    protected Flowable<Event> runLiveImpl(InvocationContext invocationContext) {
        // Not used in these tests
        return Flowable.empty();
    }
    @BeforeEach
    public void setUp() {
        invocationContext = mock(InvocationContext.class);
    }
    private static Event mockEventWithEscalate(Optional<Boolean> escalate) {
        Event event = mock(Event.class);
        EventActions actions = mock(EventActions.class);
        when(event.actions()).thenReturn(actions);
        when(actions.escalate()).thenReturn(escalate);
        return event;
    }
    // Helper class to allow instantiating LoopAgent for tests
    private static class TestLoopAgent extends LoopAgent {
        private final List<? extends BaseAgent> subAgentsOverride;
        public TestLoopAgent(String name, String description, List<? extends BaseAgent> subAgents, Optional<Integer> maxIterations, List<Callbacks.BeforeAgentCallback> beforeAgentCallback, List<Callbacks.AfterAgentCallback> afterAgentCallback) {
            super(name, description, subAgents, maxIterations, beforeAgentCallback, afterAgentCallback);
            this.subAgentsOverride = subAgents;
        }
        @Override
        public List<? extends BaseAgent> subAgents() {
            return subAgentsOverride;
        }
    }
    // Scenario 1: Sub-agents List is Null
    @Test
    @Tag("boundary")
    public void testSubAgentsListIsNullReturnsEmptyFlowable() {
        loopAgent = new TestLoopAgent("name", "desc", null, Optional.empty(), ImmutableList.of(), ImmutableList.of()) {
            @Override
            public List<? extends BaseAgent> subAgents() {
                return null;
            }
        };
        Flowable<Event> result = loopAgent.runAsyncImpl(invocationContext);
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        result.subscribe(subscriber);
        subscriber.assertNoValues();
        subscriber.assertComplete();
    }
    // Scenario 2: Sub-agents List is Empty
    @Test
    @Tag("boundary")
    public void testSubAgentsListIsEmptyReturnsEmptyFlowable() {
