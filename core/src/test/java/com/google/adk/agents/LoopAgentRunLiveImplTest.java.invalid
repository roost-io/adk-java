import com.google.errorprone.annotations.CanIgnoreReturnValue;

/**
 * Unit tests for LoopAgent.runLiveImpl covering stub/exception and input independence as described.
 */
@RunWith(JUnit4.class)
public class LoopAgentRunLiveImplTest {
    private static final String ERROR_MESSAGE = "runLive is not defined for LoopAgent yet.";
    private LoopAgent createLoopAgentWithMaxIterations(Optional<Integer> maxIterations) {
        return LoopAgent.builder()
                .name("TestAgent")
                .description("TestDescription")
                .subAgents(Collections.emptyList())
                .maxIterations(maxIterations)
                .build();
    }
    private LoopAgent createLoopAgentWithSubAgents(List<? extends BaseAgent> subAgents) {
        return LoopAgent.builder()
                .name("TestAgent")
                .description("TestDescription")
                .subAgents(subAgents)
                .build();
    }
    private LoopAgent createLoopAgentWithCallbacks(List<BeforeAgentCallback> beforeCallbacks, List<AfterAgentCallback> afterCallbacks) {
        return LoopAgent.builder()
                .name("TestAgent")
                .description("TestDescription")
                .subAgents(Collections.emptyList())
                .build();
    }
    @Test
    public void testRunLiveImpl_alwaysEmitsUnsupportedOperationExceptionWithExactMessage() {
        LoopAgent agent = createLoopAgentWithMaxIterations(Optional.empty());
        InvocationContext context = Mockito.mock(InvocationContext.class);
        Flowable<Event> result = agent.runLiveImpl(context);
        TestSubscriber<Event> ts = new TestSubscriber<>();
        result.subscribe(ts);
        ts.assertError(UnsupportedOperationException.class);
        Throwable error = ts.getOnErrorEvents().get(0);
        assertThat(error).isInstanceOf(UnsupportedOperationException.class);
        assertThat(error).hasMessageThat().isEqualTo(ERROR_MESSAGE);
    }
    @Test
    public void testRunLiveImpl_emitsSingleErrorAndNoEvents() {
        LoopAgent agent = createLoopAgentWithMaxIterations(Optional.empty());
        InvocationContext context = Mockito.mock(InvocationContext.class);
        Flowable<Event> result = agent.runLiveImpl(context);
        TestSubscriber<Event> ts = new TestSubscriber<>();
        result.subscribe(ts);
        ts.assertError(UnsupportedOperationException.class);
        ts.assertNoValues();
        assertThat(ts.getOnErrorEvents()).hasSize(1);
        ts.assertNotComplete();
    }
    @Test
    public void testRunLiveImpl_emitsOnlyUnsupportedOperationExceptionType() {
        LoopAgent agent = createLoopAgentWithMaxIterations(Optional.empty());
        InvocationContext context = Mockito.mock(InvocationContext.class);
        TestSubscriber<Event> ts = new TestSubscriber<>();
        agent.runLiveImpl(context).subscribe(ts);
        Throwable error = ts.getOnErrorEvents().get(0);
        assertThat(error).isInstanceOf(UnsupportedOperationException.class);
        assertThat(error.getClass().getSimpleName()).isEqualTo("UnsupportedOperationException");
    }
    @Test
    public void testRunLiveImpl_independentOfInvocationContextArgument() {
        LoopAgent agent = createLoopAgentWithMaxIterations(Optional.empty());
        InvocationContext context1 = Mockito.mock(InvocationContext.class);
        InvocationContext context2 = Mockito.mock(InvocationContext.class);
        InvocationContext contextNull = null;
        TestSubscriber<Event> ts1 = new TestSubscriber<>();
        TestSubscriber<Event> ts2 = new TestSubscriber<>();
        TestSubscriber<Event> tsNull = new TestSubscriber<>();
        agent.runLiveImpl(context1).subscribe(ts1);
        agent.runLiveImpl(context2).subscribe(ts2);
        agent.runLiveImpl(contextNull).subscribe(tsNull);
        ts1.assertError(UnsupportedOperationException.class);
        ts2.assertError(UnsupportedOperationException.class);
        tsNull.assertError(UnsupportedOperationException.class);
        assertThat(ts1.getOnErrorEvents().get(0)).hasMessageThat().isEqualTo(ERROR_MESSAGE);
        assertThat(ts2.getOnErrorEvents().get(0)).hasMessageThat().isEqualTo(ERROR_MESSAGE);
        assertThat(tsNull.getOnErrorEvents().get(0)).hasMessageThat().isEqualTo(ERROR_MESSAGE);
    }
    @Test
    public void testRunLiveImpl_streamCompletesAfterError() {
        LoopAgent agent = createLoopAgentWithMaxIterations(Optional.empty());
        InvocationContext context = Mockito.mock(InvocationContext.class);
        TestSubscriber<Event> ts = new TestSubscriber<>();
        agent.runLiveImpl(context).subscribe(ts);
        ts.assertNotComplete();
        ts.assertError(UnsupportedOperationException.class);
    }
