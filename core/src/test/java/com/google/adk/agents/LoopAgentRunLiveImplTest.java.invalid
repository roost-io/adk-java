    @Test
    public void testRunLiveImpl_noFieldStateChangeAfterInvocation() {
        Optional<Integer> maxIterations = Optional.of(100);
        List<BaseAgent> subAgents = Arrays.asList(Mockito.mock(BaseAgent.class));
        LoopAgent agent = LoopAgent.builder()
                .name("TestAgent")
                .description("TestDescription")
                .subAgents(subAgents)
                .maxIterations(maxIterations)
                .build();
        InvocationContext context = Mockito.mock(InvocationContext.class);
        List<BaseAgent> beforeSubs = subAgents;
