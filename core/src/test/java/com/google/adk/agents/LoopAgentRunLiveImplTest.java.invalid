    @Test
    public void testRunLiveImpl_withVariousMaxIterations_returnsError() {
        int[] values = {0, Integer.MAX_VALUE, Integer.MIN_VALUE, -10};
        for (int value : values) {
            LoopAgent agent = createLoopAgentWithMaxIterations(Optional.of(value));
