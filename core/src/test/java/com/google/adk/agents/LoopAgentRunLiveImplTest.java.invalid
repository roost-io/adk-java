        List<BeforeAgentCallback> emptyBefore = Collections.emptyList();
        List<BeforeAgentCallback> oneBefore = Arrays.asList(cb1);
        List<BeforeAgentCallback> manyBefore = Arrays.asList(cb1, cb2);
        List<AfterAgentCallback> emptyAfter = Collections.emptyList();
        List<AfterAgentCallback> oneAfter = Arrays.asList(acb1);
        List<AfterAgentCallback> manyAfter = Arrays.asList(acb1, acb2);
        List<List<BeforeAgentCallback>> beforeCombinations = Arrays.asList(emptyBefore, oneBefore, manyBefore);
        List<List<AfterAgentCallback>> afterCombinations = Arrays.asList(emptyAfter, oneAfter, manyAfter);
        for (List<BeforeAgentCallback> before : beforeCombinations) {
            for (List<AfterAgentCallback> after : afterCombinations) {
                LoopAgent agent = LoopAgent.builder()
                        .name("TestAgent")
